# =============================================================================
# SystemVerilog/Verilog Snippets - Organized by sqlmap3
# Author: sqlmap3
# Description: Comprehensive SystemVerilog, Verilog and UVM snippets
# =============================================================================

# =============================================================================
# FILE TEMPLATES AND HEADERS
# =============================================================================

# ============================================================================
# FILE HEADER
# ============================================================================
snippet header "File Header"
	// ===========================================================================
	// File    : ${1:$TM_FILENAME}
	// Project : ${2:Project Name}
	// Module  : ${3:$TM_FILENAME_BASE}
	// Author  : ${4:$USER}
	// Created : ${5:`strftime("%Y-%m-%d")`}
	// ===========================================================================
	// Description:
	//   ${6:Brief description of the module}
	// ===========================================================================
	
	${0}

# ============================================================================
# HEADER GUARD
# Auto-converts filename to UPPERCASE (e.g. my_agent -> MY_AGENT)
# ============================================================================
snippet header_guard "Header Guard (Auto Uppercase)"
	\`ifndef ${1:${TM_FILENAME_BASE/(.*)/${1:/upcase}/}}_SVH
	\`define $1_SVH
	
	${0}
	
	\`endif // $1_SVH

# ============================================================================
# TESTBENCH TEMPLATE
# Uses $TM_FILENAME_BASE for module name.
# Auto-links dump file name to module name ($1).
# ============================================================================
snippet tb "Testbench template (Universal)"
	\`timescale 1ns/1ps
	
	module ${1:$TM_FILENAME_BASE};
	
		localparam int PERIOD = ${2:10};
	
		logic ${3:clk};
		logic ${4:rst_n};
		${5}
	
		// Clock generation
		initial begin
			$3 = 0;
			forever #(PERIOD/2) $3 = ~$3;
		end
	
		// Reset generation
		initial begin
			$4 = 0;
			repeat(2) @(posedge $3);
			$4 = 1;
		end
	
		// DUT instantiation
		${6:dut_name} u_dut (
			.${3:clk_port}($3),
			.${4:rst_port}($4)${7}
		);
	
		// Test stimulus
		initial begin
			@(posedge $4);
			${0}
			#1000;
			\`uvm_info("TB", "Test Finished", UVM_LOW)
			\$finish;
		end
	
		// Waveform dump
		initial begin
			\$dumpfile("${1}.vcd");
			\$dumpvars(0, $1);
		end
	
	endmodule: $1
# =============================================================================
# DATA TYPES
# =============================================================================

snippet logic "Logic declaration"
	logic ${1:[7:0]} ${2:signal}${3: = ${4:0}};

snippet wire "Wire declaration"
	wire ${1:[7:0]} ${2:signal};

snippet reg "Reg declaration"
	reg ${1:[7:0]} ${2:signal}${3: = ${4:0}};

snippet bit "Bit declaration"
	bit ${1:[7:0]} ${2:signal};

snippet byte "Byte declaration"
	byte ${1:variable};

snippet int "Int declaration"
	int ${1:variable};

# ============================================================================
# PARAMETERS & LOCALPARAMS
# Note: Defaults to PARAM_NAME (Uppercase convention)
# ============================================================================
snippet parameter "Parameter declaration"
	parameter ${1:int} ${2:PARAM_NAME} = ${3:0};

snippet localparam "Localparam declaration"
	localparam ${1:int} ${2:PARAM_NAME} = ${3:0};

# ============================================================================
# TYPEDEFS (Structs, Enums, Unions)
# Auto-names based on filename (e.g. file: my_packet.sv -> my_packet_s)
# ============================================================================
snippet typedef_struct "Typedef struct"
	typedef struct packed {
		${2:// data}
	} ${1:$TM_FILENAME_BASE}_s;

snippet typedef_union "Typedef union"
	typedef union packed {
		${2:// data}
	} ${1:$TM_FILENAME_BASE}_u;

snippet typedef_enum "Typedef enum (Explicit encoding)"
	typedef enum logic ${1:[1:0]} {
		${2:IDLE}   = ${3:2'b00},
		${4:ACTIVE} = ${5:2'b01}
	} ${6:$TM_FILENAME_BASE}_e;

snippet enum "Enum definition (Auto encoding)"
	typedef enum ${1:logic} {
		${2:IDLE},
		${3:ACTIVE}
	} ${4:$TM_FILENAME_BASE}_e;

# =============================================================================
# ARRAYS
# =============================================================================

snippet dynamic_array "Dynamic array"
	${1:type} ${2:array}[];

snippet associative_array "Associative array"
	${1:type} ${2:array}[${3:key_type}];

snippet queue "Queue"
	${1:type} ${2:queue}[$];

snippet packed_array "Packed array"
	${1:type} [${2:msb}:${3:lsb}] ${4:array};

snippet unpacked_array "Unpacked array"
	${1:type} ${2:array}[${3:size}];

snippet memory "Memory declaration"
	reg [${1:7}:0] ${2:memory} [0:${3:255}];

# =============================================================================
# PROCEDURAL BLOCKS
# =============================================================================

snippet initial "Initial block"
	initial begin
	    ${1}
	end

snippet always "Always block"
	always @(${1:posedge clk}) begin
	    ${2}
	end

snippet always_ff "Always_ff block"
	always_ff @(posedge ${1:clk} or negedge ${2:rst_n}) begin
	    if (!$2)
	        ${3}
	    else
	        ${4}
	end

snippet always_comb "Always_comb block"
	always_comb begin
	    ${1}
	end

snippet always_latch "Always_latch block"
	always_latch begin
	    ${1}
	end

snippet final "Final block"
	final begin
	    ${1}
	end

# =============================================================================
# CONTROL STRUCTURES
# =============================================================================

snippet if "If statement"
	if (${1:condition}) begin
	    ${2}
	end

snippet ife "If-else statement"
	if (${1:condition}) begin
	    ${2}
	end else begin
	    ${3}
	end

snippet case "Case statement"
	case (${1:expression})
	    ${2:value1}: begin
	        ${3}
	    end
	    default: begin
	        ${4}
	    end
	endcase

snippet casex "Casex statement"
	casex (${1:expression})
	    ${2:value1}: ${3}
	    default: ${4}
	endcase

snippet casez "Casez statement"
	casez (${1:expression})
	    ${2:value1}: ${3}
	    default: ${4}
	endcase

snippet unique "Unique case"
	unique case (${1:expression})
	    ${2:value}: ${3}
	    default: ${4}
	endcase

snippet priority "Priority case"
	priority case (${1:expression})
	    ${2:value}: ${3}
	    default: ${4}
	endcase

snippet ternary "Ternary operator"
	${1:condition} ? ${2:true} : ${3:false}

# =============================================================================
# LOOPS
# =============================================================================

snippet for "For loop"
	for (${1:int i = 0}; ${2:i < n}; ${3:i++}) begin
	    ${4}
	end

snippet foreach "Foreach loop"
	foreach (${1:array}[${2:i}]) begin
	    ${3}
	end

snippet while "While loop"
	while (${1:condition}) begin
	    ${2}
	end

snippet do "Do-while loop"
	do begin
	    ${2}
	end while (${1:condition});

snippet repeat "Repeat loop"
	repeat (${1:count}) begin
	    ${2}
	end

snippet forever "Forever loop"
	forever begin
	    ${1}
	end

# =============================================================================
# FUNCTIONS AND TASKS
# =============================================================================

snippet function "Function definition"
	function ${1:void} ${2:name}(${3});
		${0}
	endfunction: $2

snippet task "Task definition"
	task ${1:name}(${2});
		${0}
	endtask: $1

snippet extern_function "Extern function declaration"
	extern function ${1:void} ${2:name}(${3});

snippet extern_task "Extern task declaration"
	extern task ${1:name}(${2});

# =============================================================================
# CLASSES
# =============================================================================


snippet class "Class definition"
	class ${1:$TM_FILENAME_BASE};
		${2:// properties}
	
		function new(string name = "$1");
			${3}
		endfunction: new
	
	endclass: $1

snippet class_param "Parameterized class"
	class ${1:$TM_FILENAME_BASE} #(
		parameter int ${2:WIDTH} = ${3:8}
	);
		${4:// properties}
	
		function new(string name = "$1");
			${5}
		endfunction: new
	
	endclass: $1

snippet virtual_class "Virtual class (Abstract)"
	virtual class ${1:$TM_FILENAME_BASE};
		${2}
		pure virtual function ${3:void} ${4:method_name}();
	endclass: $1

# ============================================================================
# CLASS KEYWORDS
# ============================================================================

snippet extends "Extends"
	extends ${1:base_class}

snippet static "Static property"
	static ${1:type} ${2:name};

snippet protected "Protected property"
	protected ${1:type} ${2:name};

snippet local "Local property"
	local ${1:type} ${2:name};

# ============================================================================
# IPC & CONCURRENCY (Fork-Join, Events, Mailbox)
# ============================================================================

snippet fork "Fork-join (All threads finish)"
	fork
		begin
			${1}
		end
		begin
			${2}
		end
	join

snippet fork_any "Fork-join_any (One thread finishes)"
	fork
		begin
			${1}
		end
		begin
			${2}
		end
	join_any

snippet fork_none "Fork-join_none (Non-blocking)"
	fork
		begin
			${1}
		end
		begin
			${2}
		end
	join_none

# ============================================================================
# SYNCHRONIZATION
# ============================================================================

snippet wait "Wait statement"
	wait (${1:condition});

snippet event "Event declaration"
	event ${1:event_name};

snippet trigger "Trigger event"
	-> ${1:event_name};

snippet wait_event "Wait for event (@)"
	@(${1:event_name});

snippet wait_order "Wait for event order"
	wait_order( ${1:a}, ${2:b}, ${3:c} )
		else \`uvm_error("ORDER", "Events out of order");

# ============================================================================
# COMMUNICATION (Mailbox, Semaphore)
# ============================================================================

snippet mailbox "Mailbox declaration"
	mailbox #(${1:logic}) ${2:mbx} = new(${3:1});

snippet semaphore "Semaphore declaration"
	semaphore ${1:key} = new(${2:1});

# ============================================================================
# RANDOMIZATION AND CONSTRAINTS
# ============================================================================

snippet randomize "Randomize with (Safety Check)"
	if (!${1:this}.randomize() with {
		${2:// constraints}
	}) begin
		\`uvm_fatal("RNDFAIL", "Randomization failed for $1")
	end

snippet constraint "Constraint block"
	constraint ${1:name}_c {
		${2}
	}

snippet dist "Distribution (:= Weight per value)"
	${1:variable} dist {
		${2:value1} := ${3:weight1},
		${4:value2} := ${5:weight2}
	};

snippet dist_range "Distribution (:/ Weight over range)"
	${1:variable} dist {
		[${2:start}:${3:end}] :/ ${4:weight}
	};

snippet solve_before "Solve before (Ordering)"
	solve ${1:order_var} before ${2:dependent_var};

snippet soft "Soft constraint"
	soft ${1:variable} == ${2:value};

snippet inside "Inside constraint"
	${1:variable} inside { [${2:min}:${3:max}] };

snippet randcase "Randcase statement"
	randcase
		${1:weight1}: ${2:stmt1};
		${3:weight2}: ${4:stmt2};
	endcase

# ============================================================================
# RANDOMIZATION HOOKS
# ============================================================================

snippet pre_randomize "pre_randomize function"
	function void pre_randomize();
		${1:super.pre_randomize();}
	endfunction

snippet post_randomize "post_randomize function"
	function void post_randomize();
		${1:super.post_randomize();}
	endfunction

# ============================================================================
# FUNCTIONAL COVERAGE
# ============================================================================

snippet covergroup "Covergroup definition"
	covergroup ${1:cg_name} @(${2:posedge clk});
		option.per_instance = 1;
		option.comment = "$1";
		
		${3:// coverpoints}
	endgroup: $1

snippet coverpoint "Coverpoint definition"
	${1:cp_name}: coverpoint ${2:signal_expr} {
		bins low  = {[0:${3:32}]};
		bins high = {[${4:33}:$]};
		${5}
	}

snippet cross "Cross coverage"
	${1:cross_name}: cross ${2:cp_name1}, ${3:cp_name2} {
		${4:// ignore_bins ...}
	}

# ============================================================================
# BINS DEFINITIONS
# ============================================================================

snippet bins "Bins (Simple Values)"
	bins ${1:bin_name} = {${2:values}};

snippet bins_range "Bins (Auto Range [])"
	// Creates separate bin for each value in range
	bins ${1:bin_name}[] = {[${2:0}:${3:3}]};

snippet bins_trans "Bins (Transition =>)"
	bins ${1:trans_name} = (${2:0} => ${3:1});

snippet ignore_bins "Ignore bins (Don't count)"
	ignore_bins ${1:ign_name} = {${2:values}};

snippet illegal_bins "Illegal bins (Error if hit)"
	illegal_bins ${1:ill_name} = {${2:values}};

snippet wildcard_bins "Wildcard bins"
	wildcard bins ${1:name} = {${2:4'b11??}};


# ============================================================================
# SVA (SYSTEMVERILOG ASSERTIONS)
# ============================================================================

snippet assert "Immediate Assertion"
	assert (${1:condition}) else \$error("${2:Assertion failed}");

snippet property "Property Definition"
	property ${1:prop_name};
		@(posedge ${2:clk}) disable iff (!${3:rst_n})
		${4:condition};
	endproperty: $1

snippet sequence "Sequence Definition"
	sequence ${1:seq_name};
		${2:req} ##${3:1} ${4:ack};
	endsequence: $1

snippet assume "Assume Property (Formal/Constraint)"
	assume property (@(posedge ${1:clk}) ${2:property_expr});

snippet cover "Cover Property (Functional Coverage)"
	cover property (@(posedge ${1:clk}) ${2:property_expr});

# ============================================================================
# COMPLETE SVA BLOCK (Property + Assert)
# ============================================================================
snippet sva "Full SVA Check"
	property ${1:prop_name}_p;
		@(posedge ${2:clk}) disable iff (!${3:rst_n})
		${4:req} |-> ${5:ack};
	endproperty: $1_p
	
	${6:a}_$1: assert property ($1_p)
		else \$error("Assertion $1 failed: %0t", \$time);

# ============================================================================
# SVA OPERATORS & FUNCTIONS
# ============================================================================

# --- Implication () ---
snippet impl_over "Overlapping Implication (|-> Same Cycle)"
	${1:antecedent} |-> ${2:consequent}

snippet impl_nonover "Non-overlapping Implication (|=> Next Cycle)"
	${1:antecedent} |=> ${2:consequent}

# --- Sequence Composition () ---
snippet throughout "Throughout (Expr holds during Seq)"
	(${1:expression}) throughout (${2:sequence})

snippet within "Within (Seq1 fits inside Seq2)"
	(${1:short_seq}) within (${2:long_seq})

snippet intersect "Intersect (Both start/end same time)"
	(${1:seq1}) intersect (${2:seq2})

snippet first_match "First Match (Discard later matches)"
	first_match(${1:sequence})

# --- Sample Value Functions () ---
snippet rose "Rise ($rose - 0 to 1)"
	$rose(${1:signal})

snippet fell "Fell ($fell - 1 to 0)"
	$fell(${1:signal})

snippet stable "Stable ($stable - No change)"
	$stable(${1:signal})

snippet past "Past ($past - Value N cycles ago)"
	$past(${1:signal}, ${2:1})

snippet onehot "Onehot ($onehot)"
	$onehot(${1:signal})
# ============================================================================
# GENERATE CONSTRUCTS
# ============================================================================

snippet generate "Generate For Loop"
	generate
		for (genvar ${1:i} = 0; $1 < ${2:N}; $1++) begin : ${3:gen_blk}
			${4}
		end
	endgenerate

snippet generate_if "Generate If"
	generate
		if (${1:CONDITION}) begin : ${2:gen_blk}
			${3}
		end
	endgenerate

snippet generate_case "Generate Case"
	generate
		case (${1:CONDITION})
			${2:VAL_A}: begin : ${3:blk_a}
				${4}
			end
			default: begin : ${5:blk_def}
				${6}
			end
		endcase
	endgenerate

snippet genvar "Genvar Declaration"
	genvar ${1:i};

# ============================================================================
# INSTANTIATION
# ============================================================================

snippet inst "Module Instantiation"
	${1:module_name} #(
		.${2:PARAM_NAME}(${3:VALUE})
	) ${4:u_$1} (
		.${5:clk}(${6:clk}),
		.${7:rst_n}(${8:rst_n})${9}
	);

snippet inst_simple "Module Instantiation (No Params)"
	${1:module_name} ${2:u_$1} (
		.${3:clk}(${4:clk}),
		.${5:rst_n}(${6:rst_n})${7}
	);

snippet port "Port connection"
	.${1:port_name}(${2:signal_name})${3:,}

snippet bind "Bind statement (SVA Binding)"
	bind ${1:target_module_or_instance} ${2:checker_module} ${3:u_checker} (
		.${4:port}(${5:sig})
	);

# ============================================================================
# CLOCKING BLOCK
# Defines timing and synchronization for interfaces
# ============================================================================

snippet clocking "Clocking block"
	clocking ${1:cb} @(posedge ${2:clk});
		default input #1step output #${3:1ns};
		
		input  ${4:signal_in};
		output ${5:signal_out};
	endclocking: $1

# ============================================================================
# PREPROCESSOR DIRECTIVES
# ============================================================================

snippet define "Define macro"
	\`define ${1:MACRO_NAME} ${2:value}

snippet ifdef "If defined"
	\`ifdef ${1:MACRO_NAME}
		${2}
	\`endif

snippet ifndef "If not defined"
	\`ifndef ${1:MACRO_NAME}
		${2}
	\`endif

snippet elsif "Else if (Preprocessor)"
	\`elsif ${1:MACRO_NAME}
		${2}

snippet include "Include file"
	\`include "${1:filename.svh}"

snippet timescale "Timescale directive"
	\`timescale ${1:1ns}/${2:1ps}

snippet default_nettype "Default Nettype"
	\`default_nettype ${1:none}

# ============================================================================
# SYSTEM TASKS
# ============================================================================

snippet display "Display message"
	\$display("${1:msg}: %${2:d}", ${3:signal});

snippet display_time "Display with Time"
	\$display("[%0t] ${1:msg}", \$time, ${2:args});

snippet monitor "Monitor signals"
	\$monitor("[%0t] ${1:signal} = %${2:h}", \$time, ${3:signal});

snippet finish "Finish simulation"
	\$finish;

snippet stop "Stop simulation"
	\$stop;

snippet fatal "UVM Fatal / Fatal"
	\$fatal(${1:0}, "${2:Fatal error message}");

snippet error "UVM Error / Error"
	\$error("${1:Error message}");

snippet readmemh "Readmemh (Load Memory)"
	\$readmemh("${1:file.hex}", ${2:memory_array});

snippet readmemb "Readmemb (Binary)"
	\$readmemb("${1:file.bin}", ${2:memory_array});

snippet fopen "File Open"
	integer ${1:fd};
	$1 = \$fopen("${2:filename.txt}", "${3:w}");

snippet fclose "File Close"
	\$fclose(${1:fd});

snippet sformatf "String Format"
	\$sformatf("${1:format_str}", ${2:args})

snippet urandom "Unsigned Random"
	\$urandom()

snippet urandom_range "Random Range"
	\$urandom_range(${1:max}, ${2:min})

snippet cast "Dynamic Cast (Safe)"
	if (!\$cast(${1:dest_handle}, ${2:src_handle})) begin
		\$fatal(1, "Cast failed: $2 to $1");
	end

snippet test_plusargs "Test Plusargs"
	if (\$test\$plusargs("${1:ARG_NAME}")) begin
		${2}
	end

snippet value_plusargs "Value Plusargs"
	if (\$value\$plusargs("${1:ARG_NAME}=%d", ${2:val})) begin
		${3}
	end

# ============================================================================
# FSM TEMPLATE (Standard 3-Process or 2-Process style)
# ============================================================================

snippet fsm "Finite State Machine Template"
	// --- FSM State Definitions ---
	typedef enum logic [${1:1}:0] {
		${2:IDLE}   = ${3:2'b00},
		${4:ACTIVE} = ${5:2'b01},
		${6:DONE}   = ${7:2'b10}
	} ${8:state}_e;
	
	$8_e current_state, next_state;
	
	// --- State Transition (Sequential) ---
	always_ff @(posedge ${9:clk} or negedge ${10:rst_n}) begin
		if (!$10) begin
			current_state <= $2;
		end else begin
			current_state <= next_state;
		end
	end
	
	// --- Next State Logic (Combinational) ---
	always_comb begin
		next_state = current_state; // Default to hold state
		case (current_state)
			$2: begin
				if (${11:start}) next_state = $4;
			end
			
			$4: begin
				${12:// logic}
				next_state = $6;
			end
			
			$6: begin
				next_state = $2;
			end
			
			default: next_state = $2;
		endcase
	end

# ============================================================================
# COMMON RTL PATTERNS
# ============================================================================

snippet fifo "Synchronous FIFO (Extra Bit Logic)"
	// FIFO Parameters
	localparam int FIFO_DEPTH = ${1:16};
	localparam int DATA_W     = ${2:32};
	localparam int PTR_W      = \$clog2(FIFO_DEPTH);
	
	// Pointers (Extra bit for Full/Empty distinction)
	logic [PTR_W:0] wr_ptr, rd_ptr;
	logic [DATA_W-1:0] mem [FIFO_DEPTH];
	
	logic full, empty;
	logic wr_en, rd_en;
	
	// Flags
	assign empty = (wr_ptr == rd_ptr);
	assign full  = (wr_ptr[PTR_W] != rd_ptr[PTR_W]) && 
	               (wr_ptr[PTR_W-1:0] == rd_ptr[PTR_W-1:0]);
	
	// Write Logic
	always_ff @(posedge ${3:clk} or negedge ${4:rst_n}) begin
		if (!$4) begin
			wr_ptr <= '0;
		end else if (${5:push} && !full) begin
			mem[wr_ptr[PTR_W-1:0]] <= ${6:wdata};
			wr_ptr <= wr_ptr + 1'b1;
		end
	end
	
	// Read Logic
	always_ff @(posedge $3 or negedge $4) begin
		if (!$4) begin
			rd_ptr <= '0;
		end else if (${7:pop} && !empty) begin
			${8:rdata} <= mem[rd_ptr[PTR_W-1:0]];
			rd_ptr <= rd_ptr + 1'b1;
		end
	end

snippet handshake "Valid-Ready Handshake (Source)"
	// Source Side Logic
	always_ff @(posedge ${1:clk} or negedge ${2:rst_n}) begin
		if (!$2) begin
			${3:valid} <= 1'b0;
			${4:data}  <= '0;
		end else begin
			// Transaction accepted (Fire), can load new data
			if ($3 && ${5:ready}) begin
				if (${6:has_new_data}) begin
					$3 <= 1'b1;
					$4 <= ${7:new_data};
				end else begin
					$3 <= 1'b0;
				end
			end
			// Idle state, waiting for data
			else if (!$3 && $6) begin
				$3 <= 1'b1;
				$4 <= $7;
			end
		end
	end

snippet sync_2ff "2-Stage Synchronizer (CDC)"
	logic [${1:WIDTH-1}:0] ${2:sig}_d1, $2_d2;
	
	always_ff @(posedge ${3:clk_dest} or negedge ${4:rst_n}) begin
		if (!$4) begin
			$2_d1 <= '0;
			$2_d2 <= '0;
		end else begin
			$2_d1 <= ${5:sig_src};
			$2_d2 <= $2_d1;
		end
	end
	
	assign ${6:sig_synced} = $2_d2;

snippet counter "Simple Counter"
	logic [${1:WIDTH-1}:0] cnt;
	
	always_ff @(posedge ${2:clk} or negedge ${3:rst_n}) begin
		if (!$3) begin
			cnt <= '0;
		end else if (${4:en}) begin
			if (cnt == ${5:MAX_VAL})
				cnt <= '0;
			else
				cnt <= cnt + 1'b1;
		end
	end

snippet assign "Assign Statement"
	assign ${1:lhs} = ${2:rhs};

snippet assign_mux "Assign Mux (Ternary)"
	assign ${1:out} = (${2:sel}) ? ${3:val_true} : ${4:val_false};

snippet always_comb "Always Comb"
	always_comb begin
		${1:out} = ${2:default_val};
		if (${3:cond}) begin
			$1 = ${4:val};
		end
	end
# ============================================================================
# UVM AGENT
# ============================================================================
snippet uvm_agent "UVM Agent (Universal)"
	class ${1:$TM_FILENAME_BASE} extends uvm_agent;
		\`uvm_component_utils($1)
	
		// Sub-components
		// Tip: If filename is 'my_agent.sv', sub-components default to 'my_agent_sequencer'
		${1}_sequencer  sqr;
		${1}_driver     drv;
		${1}_monitor    mon;
	
		uvm_active_passive_enum is_active = UVM_ACTIVE;
	
		extern function new(string name = "$1", uvm_component parent = null);
		extern virtual function void build_phase(uvm_phase phase);
		extern virtual function void connect_phase(uvm_phase phase);
	
	endclass: $1
	
	function $1::new(string name = "$1", uvm_component parent = null);
		super.new(name, parent);
	endfunction: new
	
	function void $1::build_phase(uvm_phase phase);
		super.build_phase(phase);
		
		if (!uvm_config_db#(uvm_active_passive_enum)::get(this, "", "is_active", is_active))
			\`uvm_info(get_name(), "is_active not configured, using default UVM_ACTIVE", UVM_MEDIUM)
		
		mon = ${1}_monitor::type_id::create("mon", this);
		
		if (is_active == UVM_ACTIVE) begin
			sqr = ${1}_sequencer::type_id::create("sqr", this);
			drv = ${1}_driver::type_id::create("drv", this);
		end
	endfunction: build_phase
	
	function void $1::connect_phase(uvm_phase phase);
		super.connect_phase(phase);
		if (is_active == UVM_ACTIVE) begin
			drv.seq_item_port.connect(sqr.seq_item_export);
		end
	endfunction: connect_phase

# ============================================================================
# UVM DRIVER
# ============================================================================
snippet uvm_driver "UVM Driver (Universal)"
	class ${1:$TM_FILENAME_BASE} extends uvm_driver #(${2:${1}_item});
		\`uvm_component_utils($1)
	
		virtual ${3:${1}_if} vif;
	
		extern function new(string name = "$1", uvm_component parent = null);
		extern virtual function void build_phase(uvm_phase phase);
		extern virtual task run_phase(uvm_phase phase);
		extern virtual task drive_item($2 item);
	
	endclass: $1
	
	function $1::new(string name = "$1", uvm_component parent = null);
		super.new(name, parent);
	endfunction: new
	
	function void $1::build_phase(uvm_phase phase);
		super.build_phase(phase);
		if (!uvm_config_db#(virtual $3)::get(this, "", "vif", vif))
			\`uvm_fatal(get_name(), "Virtual interface not found!")
	endfunction: build_phase
	
	task $1::run_phase(uvm_phase phase);
		forever begin
			seq_item_port.get_next_item(req);
			drive_item(req);
			seq_item_port.item_done();
		end
	endtask: run_phase
	
	task $1::drive_item($2 item);
		// TODO: Implement protocol-specific driving
		// Example:
		// @(posedge vif.clk);
		// vif.data <= item.data;
		${0}
	endtask: drive_item

# ============================================================================
# UVM MONITOR
# ============================================================================
snippet uvm_monitor "UVM Monitor (Universal)"
	class ${1:$TM_FILENAME_BASE} extends uvm_monitor;
		\`uvm_component_utils($1)
	
		uvm_analysis_port #(${2:${1}_item}) ap;
		virtual ${3:${1}_if} vif;
	
		extern function new(string name = "$1", uvm_component parent = null);
		extern virtual function void build_phase(uvm_phase phase);
		extern virtual task run_phase(uvm_phase phase);
		extern virtual task collect_transaction(output $2 item);
	
	endclass: $1
	
	function $1::new(string name = "$1", uvm_component parent = null);
		super.new(name, parent);
	endfunction: new
	
	function void $1::build_phase(uvm_phase phase);
		super.build_phase(phase);
		ap = new("ap", this);
		if (!uvm_config_db#(virtual $3)::get(this, "", "vif", vif))
			\`uvm_fatal(get_name(), "Virtual interface not found!")
	endfunction: build_phase
	
	task $1::run_phase(uvm_phase phase);
		forever begin
			$2 item;
			collect_transaction(item);
			\`uvm_info(get_name(), item.convert2string(), UVM_HIGH)
			ap.write(item);
		end
	endtask: run_phase
	
	task $1::collect_transaction(output $2 item);
		item = $2::type_id::create("item");
		// TODO: Monitor Logic
		// @(posedge vif.clk);
		// if (vif.valid) item.data = vif.data;
		${0}
	endtask: collect_transaction

# ============================================================================
# UVM SEQUENCER
# ============================================================================
snippet uvm_sequencer "UVM Sequencer (Universal)"
	class ${1:$TM_FILENAME_BASE} extends uvm_sequencer #(${2:${1}_item});
		\`uvm_component_utils($1)
	
		extern function new(string name = "$1", uvm_component parent = null);
	
	endclass: $1
	
	function $1::new(string name = "$1", uvm_component parent = null);
		super.new(name, parent);
	endfunction: new

# ============================================================================
# UVM SEQUENCE
# ============================================================================
snippet uvm_sequence "UVM Sequence (Universal)"
	class ${1:$TM_FILENAME_BASE} extends uvm_sequence #(${2:${1}_item});
		\`uvm_object_utils($1)
	
		rand int unsigned num_trans = ${3:10};
	
		extern function new(string name = "$1");
		extern virtual task body();
		extern virtual task pre_body();
		extern virtual task post_body();
	
	endclass: $1
	
	function $1::new(string name = "$1");
		super.new(name);
	endfunction: new
	
	task $1::pre_body();
		if (starting_phase != null)
			starting_phase.raise_objection(this);
	endtask: pre_body
	
	task $1::body();
		repeat (num_trans) begin
			\`uvm_do(req)
		end
	endtask: body
	
	task $1::post_body();
		if (starting_phase != null)
			starting_phase.drop_objection(this);
	endtask: post_body

# ============================================================================
# UVM SEQUENCE ITEM
# ============================================================================
snippet sequence_item "UVM Sequence Item (Universal)"
	class ${1:$TM_FILENAME_BASE} extends uvm_sequence_item;
		\`uvm_object_utils($1)
	
		// --- Transaction Fields ---
		rand bit [${2:7}:0]  ${3:addr};
		rand bit [${4:31}:0] ${5:data};
		${6}
	
		// --- Constraints ---
		constraint ${7:valid}_c {
			$3 inside {[0:100]};
			${8}
		}
	
		// --- Standard UVM Methods ---
		extern function new(string name = "$1");
		extern function void do_copy(uvm_object rhs);
		extern function bit do_compare(uvm_object rhs, uvm_comparer comparer);
		extern function void do_print(uvm_printer printer);
		extern function string convert2string();
	
	endclass: $1
	
	function $1::new(string name = "$1");
		super.new(name);
	endfunction: new
	
	function void $1::do_copy(uvm_object rhs);
		$1 rhs_;
		if (!$cast(rhs_, rhs))
			\`uvm_fatal(get_type_name(), "Cast failed in do_copy")
		super.do_copy(rhs);
		
		this.$3 = rhs_.$3;
		this.$5 = rhs_.$5;
	endfunction: do_copy
	
	function bit $1::do_compare(uvm_object rhs, uvm_comparer comparer);
		$1 rhs_;
		if (!$cast(rhs_, rhs))
			return 0;
		return (super.do_compare(rhs, comparer) &&
				(this.$3 == rhs_.$3) &&
				(this.$5 == rhs_.$5));
	endfunction: do_compare
	
	function void $1::do_print(uvm_printer printer);
		super.do_print(printer);
		// Using $bits to safely detect size
		printer.print_field_int("$3", this.$3, $bits(this.$3), UVM_HEX);
		printer.print_field_int("$5", this.$5, $bits(this.$5), UVM_HEX);
	endfunction: do_print
	
	function string $1::convert2string();
		return $sformatf("$3=0x%0h, $5=0x%0h", $3, $5);
	endfunction: convert2string
# ============================================================================
# SYSTEMVERILOG ASSERTIONS (SVA) - COMPREHENSIVE
# ============================================================================

# --- Basic Property Definition ---
snippet sva_property "SVA Property Definition"
	property ${1:prop_name};
		@(posedge ${2:clk}) disable iff (!${3:rst_n})
		${4:antecedent} |-> ${5:consequent};
	endproperty: $1
	
	${6:a}_$1: assert property ($1)
		else \`uvm_error("ASSERT", \$sformatf("$1 failed at %0t", \$time));

# --- Sequence Definition ---
snippet sva_sequence "SVA Sequence Definition"
	sequence ${1:seq_name};
		${2:expression};
	endsequence: $1

# --- Implication Examples ---
snippet sva_implication "SVA Implication Examples"
	// Overlapping (|->): Consequent checked in SAME cycle
	property ${1:overlap_p};
		@(posedge ${2:clk}) disable iff (!${3:rst_n})
		${4:req} |-> ${5:grant};
	endproperty
	
	// Non-overlapping (|=>): Consequent checked in NEXT cycle
	property ${6:nonoverlap_p};
		@(posedge $2) disable iff (!$3)
		$4 |=> $5;
	endproperty

# --- Delay Operators ---
snippet sva_delay "SVA Delay Operators"
	// Fixed Delay (##n)
	property ${1:fixed_delay_p};
		@(posedge ${2:clk}) ${3:req} |-> ##${4:2} ${5:ack};
	endproperty
	
	// Range Delay (##[min:max])
	property ${6:range_delay_p};
		@(posedge $2) $3 |-> ##[${7:1}:${8:5}] $5;
	endproperty
	
	// Unbounded Delay (##[1:$])
	property ${9:unbounded_delay_p};
		@(posedge $2) $3 |-> ##[1:$] $5;
	endproperty

# --- Repetition Operators ---
snippet sva_repetition "SVA Repetition Operators"
	// Consecutive [*n]: Signal holds for n cycles continuously
	property ${1:consecutive_rep_p};
		@(posedge ${2:clk}) ${3:busy}[*${4:3}] ##1 ${5:done};
	endproperty
	
	// Goto [->n]: Signal occurs n times (non-consecutive), implies immediate follow
	property ${6:goto_rep_p};
		@(posedge $2) ${7:valid}[->${8:3}] ##1 ${9:complete};
	endproperty
	
	// Non-consecutive [=n]: Signal occurs n times (non-consecutive)
	property ${10:noncons_rep_p};
		@(posedge $2) ${11:valid}[=${12:3}];
	endproperty

# --- Advanced Patterns ---
snippet sva_advanced "SVA Advanced Patterns"
	// 1. Request-Acknowledge with Timeout
	property ${1:req_ack_timeout_p};
		@(posedge ${2:clk}) disable iff (!${3:rst_n})
		${4:req} |-> ##[1:${5:10}] ${6:ack};
	endproperty
	
	// 2. Mutual Exclusion (Mutex)
	property ${7:mutex_p};
		@(posedge $2) disable iff (!$3)
		${8:sig_a} |-> !${9:sig_b};
	endproperty
	
	// 3. FIFO Full/Empty Mutex
	property ${10:fifo_integrity_p};
		@(posedge $2) disable iff (!$3)
		!(${11:full} && ${12:empty});
	endproperty
	
	// 4. Handshake (Valid stable until Ready)
	property ${13:handshake_p};
		@(posedge $2) disable iff (!$3)
		${14:valid} && !${15:ready} |=> \$stable($14);
	endproperty

# --- Coverage & Constraints ---
snippet sva_cover "SVA Cover Property"
	property ${1:cover_p};
		@(posedge ${2:clk}) ${3:condition};
	endproperty
	
	c_$1: cover property ($1)
		statement; // Optional: \`uvm_info("COV", "Hit!", UVM_LOW)

snippet sva_assume "SVA Assume Property (Formal)"
	property ${1:assume_p};
		@(posedge ${2:clk}) ${3:constraint_expr};
	endproperty
	
	assume_$1: assume property ($1);

# --- Immediate Assertions ---
snippet sva_immediate "SVA Immediate Assertion"
	assert (${1:condition}) else \`uvm_error("ASSERT", "${2:Assertion failed}");

# --- System Functions ---
snippet sva_system "SVA System Functions"
	// $rose (0->1), $fell (1->0), $stable (no change)
	property ${1:edge_detect_p};
		@(posedge ${2:clk}) \$rose(${3:sig}) |-> ##1 \$fell($3);
	endproperty
	
	// $onehot (Exactly 1 bit), $onehot0 (0 or 1 bit)
	property ${4:onehot_check_p};
		@(posedge $2) \$onehot(${5:bus});
	endproperty
	
	// $isunknown (Check for X/Z)
	property ${6:unknown_check_p};
		@(posedge $2) !\$isunknown(${7:sig});
	endproperty

# --- FIFO Protocol Assertions ---
snippet sva_fifo "SVA FIFO Suite"
	// 1. No write when full
	assert_no_wr_full: assert property (
		@(posedge ${1:clk}) disable iff (!${2:rst_n})
		${3:full} |-> !${4:wr_en}
	) else \`uvm_error("FIFO", "Write to full FIFO");

	// 2. No read when empty
	assert_no_rd_empty: assert property (
		@(posedge $1) disable iff (!$2)
		${5:empty} |-> !${6:rd_en}
	) else \`uvm_error("FIFO", "Read from empty FIFO");

	// 3. Write increments count
	assert_wr_inc: assert property (
		@(posedge $1) disable iff (!$2)
		$4 && !$3 |=> ${7:count} == \$past($7) + 1
	);

# --- AXI Protocol Assertions ---
snippet sva_axi "SVA AXI Examples"
	// 1. Valid must remain stable until Ready
	property ${1:axi_valid_stable_p};
		@(posedge ${2:clk}) disable iff (!${3:rst_n})
		${4:valid} && !${5:ready} |=> \$stable($4) && \$stable(${6:data});
	endproperty
	assert_$1: assert property ($1);
	
	// 2. BVALID follows WLAST/WREADY
	property ${7:axi_write_response_p};
		@(posedge $2) disable iff (!$3)
		${8:wlast} && ${9:wready} |-> ##[1:${10:16}] ${11:bvalid};
	endproperty
	assert_$7: assert property ($7);
# ============================================================================
# MACROS AND PREPROCESSOR (IEEE 1800-2012 Section 22)
# ============================================================================

snippet macro_define "Define macro with arguments"
	\`define ${1:MACRO_NAME}(${2:args}) \\
		${3:body}

snippet macro_stringify "Stringify operator (`"x`")"
	// Converts argument to string: \`"val\`" -> "val"
	\`define ${1:TO_STRING}(${2:x}) \`"${2}\`"

snippet macro_concat "Token pasting operator (``)"
	// Joins two tokens: a\`\`b -> ab
	\`define ${1:CONCAT}(${2:a}, ${3:b}) ${2}\`\`${3}

snippet macro_ifdef_block "Ifdef / Else / Endif"
	\`ifdef ${1:MACRO_NAME}
		${2:// code when defined}
	\`else
		${3:// code when not defined}
	\`endif

snippet macro_ifndef_block "Ifndef / Else / Endif"
	\`ifndef ${1:MACRO_NAME}
		${2:// code when not defined}
	\`else
		${3:// code when defined}
	\`endif

snippet macro_undef "Undefine macro"
	\`undef ${1:MACRO_NAME}

snippet macro_line "Line directive"
	\`line ${1:line_number} "${2:filename}" ${3:level}

snippet macro_default_nettype "Default Nettype (Safety: none)"
	// Forces explicit declaration of all signals (Best Practice)
	\`default_nettype ${1:none}

snippet macro_resetall "Reset compiler directives"
	\`resetall

snippet macro_celldefine "Cell define block (Library)"
	\`celldefine
	${1:module ... endmodule}
	\`endcelldefine

snippet macro_pragma "Pragma directive"
	\`pragma ${1:protect} ${2:param}

snippet macro_begin_keywords "Begin Keywords (Legacy Support)"
	\`begin_keywords "${1:1800-2012}"
	${2}
	\`end_keywords
# ============================================================================
# COMMON UVM MACROS
# ============================================================================

snippet uvm_info_macro "UVM_INFO macro"
	\`uvm_info("${1:ID}", \$sformatf("${2:Msg: %s}", ${3:arg}), ${4:UVM_MEDIUM})

snippet uvm_warning_macro "UVM_WARNING macro"
	\`uvm_warning("${1:ID}", \$sformatf("${2:Msg: %s}", ${3:arg}))

snippet uvm_error_macro "UVM_ERROR macro"
	\`uvm_error("${1:ID}", \$sformatf("${2:Msg: %s}", ${3:arg}))

snippet uvm_fatal_macro "UVM_FATAL macro"
	\`uvm_fatal("${1:ID}", \$sformatf("${2:Msg: %s}", ${3:arg}))

# --- Sequence Macros ---

snippet uvm_do_macro "UVM_DO macro"
	\`uvm_do(${1:item})

snippet uvm_do_with_macro "UVM_DO_WITH macro"
	\`uvm_do_with(${1:item}, {
		${2:constraint};
	})

snippet uvm_create_macro "UVM_CREATE macro"
	\`uvm_create(${1:item})

snippet uvm_send_macro "UVM_SEND macro"
	\`uvm_send(${1:item})

snippet uvm_rand_send_macro "UVM_RAND_SEND macro"
	\`uvm_rand_send(${1:item})

snippet uvm_rand_send_with_macro "UVM_RAND_SEND_WITH macro"
	\`uvm_rand_send_with(${1:item}, {
		${2:constraint};
	})

# --- Field Automation Macros ---

snippet uvm_field_int "UVM_FIELD_INT"
	\`uvm_field_int(${1:field_name}, ${2:UVM_ALL_ON})

snippet uvm_field_object "UVM_FIELD_OBJECT"
	\`uvm_field_object(${1:handle_name}, ${2:UVM_ALL_ON})

snippet uvm_field_string "UVM_FIELD_STRING"
	\`uvm_field_string(${1:str_name}, ${2:UVM_ALL_ON})

snippet uvm_field_enum "UVM_FIELD_ENUM"
	\`uvm_field_enum(${1:enum_type}, ${2:enum_val}, ${3:UVM_ALL_ON})

snippet uvm_field_array_int "UVM_FIELD_ARRAY_INT"
	\`uvm_field_array_int(${1:array_name}, ${2:UVM_ALL_ON})

snippet uvm_field_sarray_int "UVM_FIELD_SARRAY_INT (Static Array)"
	\`uvm_field_sarray_int(${1:array_name}, ${2:UVM_ALL_ON})

snippet uvm_field_queue "UVM_FIELD_QUEUE"
	\`uvm_field_queue_${1:int}(${2:queue_name}, ${3:UVM_ALL_ON})

snippet uvm_field_aa "UVM_FIELD_AA (Assoc Array)"
	\`uvm_field_aa_${1:int}_${2:string}(${3:aa_name}, ${4:UVM_ALL_ON})

# ============================================================================
# COMMON UTILITY MACROS (Safe Implementation)
# ============================================================================

snippet macro_min "MIN(a, b)"
	\`define MIN(a, b) (((a) < (b)) ? (a) : (b))

snippet macro_max "MAX(a, b)"
	\`define MAX(a, b) (((a) > (b)) ? (a) : (b))

snippet macro_abs "ABS(x)"
	\`define ABS(x) (((x) < 0) ? -(x) : (x))

snippet macro_clamp "CLAMP(x, min, max)"
	\`define CLAMP(x, min, max) (((x) < (min)) ? (min) : (((x) > (max)) ? (max) : (x)))

snippet macro_swap "SWAP(a, b, tmp)"
	\`define SWAP(a, b, tmp) \\
		tmp = a; \\
		a = b; \\
		b = tmp;

snippet macro_bit_width "BIT_WIDTH(x) - using $clog2"
	\`define BIT_WIDTH(x) (\$clog2(x))

snippet macro_is_power_of_2 "IS_POWER_OF_2(x)"
	\`define IS_POWER_OF_2(x) (((x) != 0) && (((x) & ((x) - 1)) == 0))

snippet macro_align_up "ALIGN_UP(x, align)"
	\`define ALIGN_UP(x, align) ((((x) + (align) - 1) / (align)) * (align))

snippet macro_div_round_up "DIV_ROUND_UP(x, y)"
	\`define DIV_ROUND_UP(x, y) (((x) + (y) - 1) / (y))
# ============================================================================
# VERIFICATION MACROS (Safety Checks)
# ============================================================================

snippet macro_check_fatal "CHECK_FATAL(cond, msg)"
	\`define CHECK_FATAL(cond, msg) \\
		if (!(cond)) begin \\
			\$fatal(1, msg); \\
		end

snippet macro_check_error "CHECK_ERROR(cond, msg)"
	\`define CHECK_ERROR(cond, msg) \\
		if (!(cond)) begin \\
			\$error(msg); \\
		end

snippet macro_check_warning "CHECK_WARNING(cond, msg)"
	\`define CHECK_WARNING(cond, msg) \\
		if (!(cond)) begin \\
			\$warning(msg); \\
		end

snippet macro_assert_simple "ASSERT(cond)"
	// Simple immediate assertion with auto-stringified error
	\`define ASSERT(cond) \\
		assert(cond) else \$error("ASSERT FAILED: \`"cond\`" at %m")

snippet macro_cover_simple "COVER(clk, cond)"
	// Simple functional coverage point
	\`define COVER(clk_edge, cond) \\
		cover property (@(clk_edge) cond)

# ============================================================================
# DEBUG MACROS (Print helpers)
# ============================================================================

snippet macro_debug "DEBUG_PRINT(msg)"
	\`ifdef DEBUG
		// Note: Use %s to print the message argument
		\`define DEBUG_PRINT(msg) \$display("[DEBUG] %0t: %s", \$time, msg)
	\`else
		\`define DEBUG_PRINT(msg)
	\`endif

snippet macro_verbose "VERBOSE_PRINT(lvl, msg)"
	\`ifdef VERBOSE
		\`define VERBOSE_PRINT(lvl, msg) \\
			if (verbose_level >= lvl) \$display("[VERBOSE] %s", msg)
	\`else
		\`define VERBOSE_PRINT(lvl, msg)
	\`endif

snippet macro_trace "TRACE(msg)"
	// Prints time, module path (%m) and message
	\`define TRACE(msg) \$display("[TRACE] %0t %m: %s", \$time, msg)

snippet macro_dump_vars "DUMP_VARS(var)"
	// Prints variable name (stringified) and its value
	\`define DUMP_VARS(var) \\
		\$display("[DUMP] %0t %m: \`"var\`" = 0x%0h", \$time, var)
# ============================================================================
# REGISTER ACCESS MACROS (Backdoor / TB Helper)
# Warning: Requires 'clk', 'reg_addr', 'reg_wdata', 'reg_wr_en' in scope!
# ============================================================================

snippet macro_reg_write "REG_WRITE(addr, data)"
	\`define REG_WRITE(a, d) \\
		@(posedge clk); \\
		reg_addr  = a; \\
		reg_wdata = d; \\
		reg_wr_en = 1'b1; \\
		@(posedge clk); \\
		reg_wr_en = 1'b0;

snippet macro_reg_read "REG_READ(addr, data_container)"
	\`define REG_READ(a, d) \\
		@(posedge clk); \\
		reg_addr  = a; \\
		reg_rd_en = 1'b1; \\
		@(posedge clk); \\
		d = reg_rdata; \\
		reg_rd_en = 1'b0;

snippet macro_reg_field "REG_FIELD(reg, msb, lsb)"
	\`define REG_FIELD(r, msb, lsb) r[msb:lsb]

snippet macro_reg_bit "REG_BIT(reg, bit)"
	\`define REG_BIT(r, b) r[b]

# ============================================================================
# TIMING MACROS
# ============================================================================

snippet macro_wait_clks "WAIT_CLKS(n)"
	\`define WAIT_CLKS(n) \\
		repeat(n) @(posedge clk);

snippet macro_wait_ns "WAIT_NS(ns)"
	\`define WAIT_NS(n) \\
		#(n * 1ns);

snippet macro_wait_until "WAIT_UNTIL(cond)"
	\`define WAIT_UNTIL(cond) \\
		wait(cond);

snippet macro_wait_clk_edge "WAIT_CLK_EDGE"
	\`define WAIT_CLK_EDGE \\
		@(posedge clk);

# ============================================================================
# ARRAY/MEMORY UTILITIES (Using Native SV Methods)
# Note: Macros are bad for these; used inline SV methods instead.
# ============================================================================

snippet array_sum "Array Sum (Native .sum)"
	// Use 'with' for bit-width expansion safety
	${1:sum_var} = ${2:array}.sum() with (int'(item));

snippet array_fill "Array Fill (Native)"
	${1:array} = '{default: ${2:value}};

snippet macro_array_copy_loop "ARRAY_COPY (Foreach Loop)"
	\`define ARRAY_COPY(dst, src) \\
		foreach (src[i]) dst[i] = src[i];

snippet macro_queue_push "QUEUE_PUSH (Back)"
	\`define Q_PUSH(q, val) q.push_back(val);

snippet macro_queue_pop "QUEUE_POP (Front)"
	\`define Q_POP(q, val) val = q.pop_front();

# ============================================================================
# CONDITIONAL COMPILATION
# ============================================================================

snippet macro_synthesis "SYNTHESIS Block"
	\`ifdef SYNTHESIS
		${1:// RTL Code for synthesis}
	\`else
		${2:// Behavioral code for simulation}
	\`endif

snippet macro_formal "FORMAL Verification Block"
	\`ifdef FORMAL
		${1:// Assertions/Assumptions for Formal Tools}
	\`endif

snippet macro_coverage "COVERAGE Block"
	\`ifdef COVERAGE
		${1:// Covergroups / Coverpoints}
	\`endif

snippet macro_simulation "SIMULATION Only Block"
	\`ifndef SYNTHESIS
		${1:// Testbench / Debug code}
	\`endif
# ============================================================================
# CODE GENERATION MACROS (Advanced)
# Uses Token Pasting (``) to auto-generate signal names
# ============================================================================

snippet macro_gen_comparator "GEN_COMPARATOR(name, width)"
	// Generates a complete comparator module
	\`define GEN_COMPARATOR(mod_name, width) \\
	module mod_name ( \\
		input  logic [width-1:0] a, \\
		input  logic [width-1:0] b, \\
		output logic             eq, \\
		output logic             gt, \\
		output logic             lt  \\
	); \\
		assign eq = (a == b); \\
		assign gt = (a >  b); \\
		assign lt = (a <  b); \\
	endmodule

snippet macro_gen_register "GEN_REGISTER(name, width, rst_val)"
	// Requires scope signals: name_en, name_next, clk, rst_n
	\`define GEN_REGISTER(name, width, rval) \\
	always_ff @(posedge clk or negedge rst_n) begin \\
		if (!rst_n) \\
			name <= rval; \\
		else if (name\`\`_en) \\
			name <= name\`\`_next; \\
	end

snippet macro_gen_fifo_sigs "GEN_FIFO_SIGS(name, width, depth)"
	// Declares signals for a FIFO
	\`define GEN_FIFO_SIGS(name, width, depth) \\
	logic [width-1:0] name\`\`_mem [depth]; \\
	logic [\$clog2(depth)-1:0] name\`\`_wr_ptr, name\`\`_rd_ptr; \\
	logic name\`\`_full, name\`\`_empty;

# ============================================================================
# PROTOCOL-SPECIFIC MACROS (TB Helpers)
# ============================================================================

# --- AXI4 Helper Macros ---

snippet macro_axi_handshake "AXI_HANDSHAKE(valid, ready)"
	\`define AXI_HANDSHAKE(valid, ready) \\
		((valid) && (ready))

snippet macro_axi_wait "AXI_WAIT_HANDSHAKE(valid, ready)"
	\`define AXI_WAIT_HANDSHAKE(valid, ready) \\
		do begin \\
			@(posedge clk); \\
		end while (!((valid) && (ready)));

# --- APB3/APB4 Master Macros (With PREADY support) ---

snippet macro_apb_write "APB_WRITE(addr, data)"
	\`define APB_WRITE(addr, data) \\
		@(posedge clk); \\
		paddr   = addr; \\
		pwdata  = data; \\
		pwrite  = 1'b1; \\
		psel    = 1'b1; \\
		penable = 1'b0; \\
		@(posedge clk); \\
		penable = 1'b1; \\
		// Wait for slave ready \\
		while (!pready) @(posedge clk); \\
		pwrite  = 1'b0; \\
		psel    = 1'b0; \\
		penable = 1'b0;

snippet macro_apb_read "APB_READ(addr, data_container)"
	\`define APB_READ(addr, data) \\
		@(posedge clk); \\
		paddr   = addr; \\
		pwrite  = 1'b0; \\
		psel    = 1'b1; \\
		penable = 1'b0; \\
		@(posedge clk); \\
		penable = 1'b1; \\
		// Wait for slave ready \\
		while (!pready) @(posedge clk); \\
		data    = prdata; \\
		psel    = 1'b0; \\
		penable = 1'b0;
# ============================================================================
# STRING MANIPULATION
# ============================================================================

snippet macro_str_concat "STR_CONCAT(a, b)"
	\`define STR_CONCAT(a, b) {a, b}

snippet macro_str_format "STR_FORMAT(fmt, args)"
	\`define STR_FORMAT(fmt, args) \\
		\$sformatf(fmt, args)

snippet macro_to_hex "TO_HEX(val)"
	\`define TO_HEX(val) \\
		\$sformatf("0x%0h", val)

snippet macro_to_bin "TO_BIN(val)"
	\`define TO_BIN(val) \\
		\$sformatf("%0b", val)

# ============================================================================
# FILE I/O OPERATIONS (Safe Wrappers)
# ============================================================================

snippet macro_file_open "FILE_OPEN(handle, filename, mode)"
	\`define FILE_OPEN(handle, fname, mode) \\
		handle = \$fopen(fname, mode); \\
		if (!handle) begin \\
			\$fatal(1, \$sformatf("Failed to open file: %s", fname)); \\
		end

snippet macro_file_write "FILE_WRITE(handle, fmt, args)"
	\`define FILE_WRITE(handle, fmt, args) \\
		\$fdisplay(handle, fmt, args);

snippet macro_file_close "FILE_CLOSE(handle)"
	\`define FILE_CLOSE(handle) \\
		\$fclose(handle);

# ============================================================================
# RANDOMIZATION HELPERS
# ============================================================================

snippet macro_rand_range "RAND_RANGE(min, max)"
	\`define RAND_RANGE(min, max) \\
		(\$urandom_range((max), (min)))

snippet macro_rand_bool "RAND_BOOL"
	\`define RAND_BOOL \\
		((\$urandom() & 1'b1))

snippet macro_rand_choice "RAND_CHOICE(array, size)"
	// Returns a random element from an array
	\`define RAND_CHOICE(arr, size) \\
		arr[\$urandom_range((size)-1, 0)]

# ============================================================================
# PERFORMANCE & PROFILING
# Note: Variables defined here require macros to be used in proper scope
# ============================================================================

snippet macro_perf_start "PERF_START(name)"
	\`define PERF_START(name) \\
		realtime name\`\`_start_time = \$realtime;

snippet macro_perf_end "PERF_END(name)"
	\`define PERF_END(name) \\
		\$display("[PERF] %s: %.2f ns", \`"name\`", (\$realtime - name\`\`_start_time));

snippet macro_cycle_count_start "CYCLE_COUNT_START(name)"
	\`define CYCLE_COUNT_START(name) \\
		int name\`\`_cycle_cnt = 0;

snippet macro_cycle_count_inc "CYCLE_COUNT_INC(name)"
	\`define CYCLE_COUNT_INC(name) \\
		name\`\`_cycle_cnt++;

snippet macro_cycle_count_report "CYCLE_COUNT_REPORT(name)"
	\`define CYCLE_COUNT_REPORT(name) \\
		\$display("[CYCLES] %s: %0d cycles", \`"name\`", name\`\`_cycle_cnt);
# ============================================================================
# ADDITIONAL SYSTEMVERILOG CONSTRUCTS (IEEE 1800-2012)
# ============================================================================

snippet checker "Checker module (Assertion Container)"
	// Checkers can be instantiated inside modules, interfaces, or procedural blocks
	checker ${1:checker_name} (
		input logic ${2:clk},
		input logic ${3:rst_n},
		input logic ${4:test_expr}
	);
		default clocking @(posedge $2); endclocking
		default disable iff (!$3);
		
		${5:assert_prop}: assert property (${4});
		${0}
	endchecker: $1

snippet let "Let declaration (Safe Macro)"
	// 'let' is like `define but with scope and type safety
	let ${1:name}(${2:args}) = ${3:expression};

snippet expect "Expect statement (Blocking Assert)"
	// Blocks execution until property succeeds
	expect (${1:property_expr}) else begin
		\`uvm_error("EXPECT", "Property failed to occur")
	end

snippet restrict "Restrict property (Formal)"
	// Constraint for Formal Verification tools
	restrict property (@(posedge ${1:clk}) ${2:constraint_expr});

snippet alias "Alias statement (Bidirectional short)"
	alias ${1:net_a} = ${2:net_b};

snippet nettype "User-defined nettype"
	nettype ${1:real} ${2:real_net} with ${3:sum_function};

# ============================================================================
# INTERFACE AND MODPORT ADVANCED
# ============================================================================

snippet interface_class "Interface class (OOP Interface)"
	// Similar to Java Interface - defines pure virtual methods
	interface class ${1:$TM_FILENAME_BASE};
		pure virtual function ${2:void} ${3:method_name}(${4:args});
	endclass: $1

snippet implements "Implements interface class"
	implements ${1:interface_class_name}

snippet modport_clocking "Modport with Clocking Block"
	modport ${1:master} (
		clocking ${2:cb},
		output ${3:reset_n}
	);

snippet interface_param "Parameterized Interface (Universal)"
	interface ${1:$TM_FILENAME_BASE} #(
		parameter int ${2:WIDTH} = ${3:32}
	) (
		input logic clk,
		input logic rst_n
	);
		
		logic [$2-1:0] ${4:data};
		logic          ${5:valid};
		logic          ${6:ready};
		
		// Clocking block for Testbench
		clocking cb @(posedge clk);
			default input #1step output #1ns;
			input  $4, $5, $6;
		endclocking
		
		modport tb (clocking cb, input rst_n);
		modport rtl (input clk, rst_n, $4, $5, output $6);
		
	endinterface: $1
# ============================================================================
# ADVANCED CLASS FEATURES
# ============================================================================

snippet extern_method "Extern method definition (Out-of-body)"
	function ${1:void} ${2:class_name}::${3:method_name}(${4:args});
		${0}
	endfunction: $3

snippet constraint_mode "Constraint mode (0/1)"
	${1:obj}.constraint_mode(${2:0});

snippet rand_mode "Rand mode (0/1)"
	${1:var}.rand_mode(${2:0});

snippet constraint_mode_specific "Specific constraint mode"
	${1:obj}.${2:constraint_name}.constraint_mode(${3:0});

snippet new_array "Dynamic array allocation"
	${1:array} = new[${2:size}];

snippet new_copy "Shallow copy (new rhs)"
	${1:dest} = new ${2:src};

snippet cast_dynamic "Dynamic Cast ($cast)"
	if (!\$cast(${1:dest}, ${2:src})) begin
		\`uvm_error("CAST", "Dynamic cast failed")
	end

# ============================================================================
# PACKAGES
# ============================================================================

snippet package "Package Definition (Universal)"
	package ${1:$TM_FILENAME_BASE};
		
		import uvm_pkg::*;
		\`include "uvm_macros.svh"
		
		${0}
		
	endpackage: $1

snippet import_pkg "Import Package"
	import ${1:pkg_name}::*;

snippet import_item "Import Specific Item"
	import ${1:pkg_name}::${2:item};

snippet export_pkg "Export Package (Chaining)"
	export ${1:pkg_name}::*;

# ============================================================================
# VIRTUAL INTERFACES
# ============================================================================

snippet vif "Virtual Interface Declaration"
	virtual ${1:interface_name} ${2:vif};

snippet vif_param "Parameterized Virtual Interface"
	virtual ${1:interface_name} #(${2:params}) ${3:vif};

snippet typedef_vif "Typedef Virtual Interface"
	typedef virtual ${1:interface_name} ${2:vif_t};

# ============================================================================
# DPI-C (Direct Programming Interface)
# ============================================================================

snippet dpi_import "DPI-C Import (Standard)"
	import "DPI-C" function ${1:void} ${2:c_func_name}(${3:input int arg});

snippet dpi_context "DPI-C Import (Context - Can call SV)"
	// Use 'context' if C code calls exported SV functions
	import "DPI-C" context function ${1:void} ${2:c_func_name}(${3:args});

snippet dpi_pure "DPI-C Import (Pure - No Side Effects)"
	// Use 'pure' for math functions (optimizable, no globals)
	import "DPI-C" pure function ${1:int} ${2:c_math_func}(${3:args});

snippet dpi_export "DPI-C Export (Allow C to call SV)"
	export "DPI-C" function ${1:sv_func_name};
# ============================================================================
# PROGRAM BLOCKS (Testbench Container)
# Note: In modern UVM, 'module' or 'interface' is preferred over 'program'.
# ============================================================================

snippet program "Program Block"
	program ${1:prog_name} (
		input logic ${2:clk},
		input logic ${3:rst_n},
		${4:interface_name} ${5:vif}
	);
		initial begin
			${0}
		end
	endprogram: $1

# ============================================================================
# CONFIGURATIONS (Library Mapping)
# ============================================================================

snippet config "Config Block"
	config ${1:cfg_name};
		design ${2:library}.${3:top_module};
		default liblist ${4:work};
		${5}
	endconfig: $1

snippet config_cell "Cell Override"
	cell ${1:inst_path} use ${2:lib}.${3:cell};

snippet config_instance "Instance Override"
	instance ${1:inst_path} use ${2:lib}.${3:module};

# ============================================================================
# SPECIFY BLOCKS (Gate Level Timing)
# ============================================================================

snippet specify "Specify Block"
	specify
		specparam ${1:tPD} = ${2:1.0};
		(${3:input} => ${4:output}) = $1;
	endspecify

snippet spec_setuphold "Setup/Hold Check"
	\$setuphold(posedge ${1:clk}, ${2:data}, ${3:setup_limit}, ${4:hold_limit});

snippet spec_width "Pulse Width Check"
	\$width(posedge ${1:sig}, ${2:min_width});

snippet spec_period "Period Check"
	\$period(posedge ${1:clk}, ${2:min_period});

snippet spec_skew "Skew Check"
	\$skew(posedge ${1:ref_clk}, posedge ${2:data_clk}, ${3:limit});

# ============================================================================
# UNIQUE / PRIORITY (Case & If)
# ============================================================================

snippet unique_if "Unique If (Parallel, No Overlap)"
	unique if (${1:cond}) begin
		${2}
	end else if (${3:cond}) begin
		${4}
	end else begin
		${5}
	end

snippet priority_if "Priority If (Sequential)"
	priority if (${1:cond}) begin
		${2}
	end else if (${3:cond}) begin
		${4}
	end

snippet unique_case "Unique Case (Parallel)"
	unique case (${1:expr})
		${2:val}: ${3:stmt};
		default: ${4:stmt};
	endcase

snippet priority_case "Priority Case (Sequential)"
	priority case (${1:expr})
		${2:val}: ${3:stmt};
		default: ${4:stmt};
	endcase

# ============================================================================
# STREAMING OPERATORS (Pack/Unpack)
# ============================================================================

snippet stream_pack "Pack {<<{src}}"
	{<<${1:slice_size}{ ${2:source} }}

snippet stream_unpack "Unpack {>>{dest}}"
	{>>${1:slice_size}{ ${2:dest} }}

snippet endian_swap "Endian Swap (32-bit)"
	{<<8{ ${1:word} }}

# ============================================================================
# ARRAY METHODS (Locator & Ordering)
# Returns: QUEUE ($)
# ============================================================================

snippet arr_find "Find with condition"
	${1:q} = ${2:arr}.find(item) with (${3:item > 5});

snippet arr_find_index "Find Index"
	${1:q_idx} = ${2:arr}.find_index(item) with (${3:item == val});

snippet arr_find_first "Find First"
	${1:q} = ${2:arr}.find_first(item) with (${3:item > val});

snippet arr_find_first_index "Find First Index"
	${1:q_idx} = ${2:arr}.find_first_index(item) with (${3:item == val});

snippet arr_unique "Unique Values"
	${1:q} = ${2:arr}.unique();

snippet arr_sort "Sort (In-Place)"
	${1:arr}.sort();

snippet arr_rsort "Reverse Sort (In-Place)"
	${1:arr}.rsort();

snippet arr_shuffle "Shuffle (Randomize)"
	${1:arr}.shuffle();

snippet arr_reverse "Reverse (In-Place)"
	${1:arr}.reverse();

# ============================================================================
# ARRAY METHODS (Reduction)
# Returns: Scalar (int, bit, etc.)
# ============================================================================

snippet arr_sum "Sum (Safe width)"
	// sum() returns width of element unless casted
	${1:total} = ${2:arr}.sum() with (int'(item));

snippet arr_product "Product"
	${1:total} = ${2:arr}.product() with (int'(item));

snippet arr_xor "Xor Reduction"
	${1:res} = ${2:arr}.xor() with (item);

snippet arr_and "And Reduction"
	${1:res} = ${2:arr}.and() with (item);

snippet arr_or "Or Reduction"
	${1:res} = ${2:arr}.or() with (item);

snippet arr_min "Min Value"
	${1:val} = ${2:arr}.min();

snippet arr_max "Max Value"
	${1:val} = ${2:arr}.max();
# =============================================================================
# STRING METHODS
# =============================================================================

snippet string_len "String length method"
	${1:str}.len()

snippet string_getc "String getc method"
	${1:str}.getc(${2:index})

snippet string_putc "String putc method"
	${1:str}.putc(${2:index}, ${3:char})

snippet string_toupper "String to upper method"
	${1:str}.toupper()

snippet string_tolower "String to lower method"
	${1:str}.tolower()

snippet string_compare "String compare method"
	${1:str}.compare(${2:str2})

snippet string_icompare "String case-insensitive compare"
	${1:str}.icompare(${2:str2})

snippet string_substr "String substr method"
	${1:str}.substr(${2:start}, ${3:end})

snippet string_atoi "String to integer"
	${1:str}.atoi()

snippet string_atohex "String hex to integer"
	${1:str}.atohex()

snippet string_atooct "String octal to integer"
	${1:str}.atooct()

snippet string_atobin "String binary to integer"
	${1:str}.atobin()

snippet string_atoreal "String to real"
	${1:str}.atoreal()

snippet string_itoa "Integer to string"
	${1:str}.itoa(${2:value})

snippet string_hextoa "Hex to string"
	${1:str}.hextoa(${2:value})

snippet string_octtoa "Octal to string"
	${1:str}.octtoa(${2:value})

snippet string_bintoa "Binary to string"
	${1:str}.bintoa(${2:value})

snippet string_realtoa "Real to string"
	${1:str}.realtoa(${2:value})

# =============================================================================
# PROCESS CONTROL
# =============================================================================

snippet process_self "Process self"
	process::self()

snippet process_status "Process status"
	${1:proc}.status()

snippet process_kill "Process kill"
	${1:proc}.kill()

snippet process_await "Process await"
	${1:proc}.await()

snippet process_suspend "Process suspend"
	${1:proc}.suspend()

snippet process_resume "Process resume"
	${1:proc}.resume()

# =============================================================================
# REFINEMENT (IEEE 1800-2012)
# =============================================================================

snippet global_clocking "Global clocking"
	global clocking ${1:cb} @(posedge ${2:clk});
	    ${3}
	endclocking

snippet default_clocking "Default clocking"
	default clocking ${1:cb};

snippet default_disable "Default disable"
	default disable iff ${1:reset};

# ============================================================================
# COVERAGE OPTIONS (Instance Level)
# Affects specific instances (per_instance, weight, etc.)
# ============================================================================

snippet option_all "All Instance Options"
	option.name            = "${1:name}";
	option.weight          = ${2:1};
	option.goal            = ${3:100};
	option.comment         = "${4:comment}";
	option.at_least        = ${5:1};
	option.auto_bin_max    = ${6:64};
	option.per_instance    = ${7:1};
	option.get_inst_coverage = ${8:0};

snippet option_per_instance "Per Instance Reporting"
	option.per_instance = 1;

snippet option_weight "Coverage Weight"
	option.weight = ${1:0}; // Set to 0 to exclude from total grade

snippet option_goal "Coverage Goal"
	option.goal = ${1:100};

# ============================================================================
# TYPE OPTIONS (Static Level)
# Affects the cumulative type (merge_instances, etc.)
# ============================================================================

snippet type_option_all "All Type Options"
	type_option.weight          = ${1:1};
	type_option.goal            = ${2:100};
	type_option.comment         = "${3:comment}";
	type_option.merge_instances = ${4:1}; // Merge all instances for total calc

snippet type_option_merge "Merge Instances"
	// Combine coverage from all instances into one 'type' bucket
	type_option.merge_instances = 1;

# ============================================================================
# ADVANCED BINS (Wildcard & Transitions)
# ============================================================================

snippet bins_wildcard "Wildcard Bins"
	// Matches using ? or z/x (e.g., 4'b11??)
	wildcard bins ${1:bin_name} = {${2:4'b10??}};

snippet bins_ignore "Ignore Bins (Exclude values)"
	ignore_bins ${1:ign} = {${2:val}};

snippet bins_illegal "Illegal Bins (Error if hit)"
	illegal_bins ${1:ill} = {${2:val}};

snippet bins_trans "Transition Bin (=>)"
	// Sequence: val1 followed by val2
	bins ${1:trans} = (${2:val1} => ${3:val2});

snippet bins_trans_list "Transition Bin List"
	// Sequence: 1->2, OR 2->3, OR 5->1
	bins ${1:trans}[] = (${2:1} => ${3:2}), (${4:2} => ${5:3});

snippet bins_repeat "Consecutive Repetition [*n]"
	// val repeats n times consecutively: 1 -> 1 -> 1
	bins ${1:rep} = (${2:val}[*${3:3}]);

snippet bins_goto "Goto Repetition [->n]"
	// val occurs n times (non-consecutive), immediately followed by next val
	// 1...1...1 => 2 (The transition happens immediately after the last 1)
	bins ${1:goto} = (${2:1}[->${3:3}] => ${4:2});

snippet bins_noncons "Non-consecutive Repetition [=n]"
	// val occurs n times (anywhere), eventually followed by next val
	// 1...1...1... => ...2
	bins ${1:noncons} = (${2:1}[=${3:3}] => ${4:2});

# ============================================================================
# RANDSEQUENCE (Procedural Randomization)
# ============================================================================

snippet randsequence "Random Sequence (Production Rules)"
	randsequence(${1:main_rule})
		${1}: ${2:first_action} ${3:second_action};
		$2: { \$display("Action 1"); };
		$3: { \$display("Action 2"); };
	endsequence

# ============================================================================
# CONSTRAINTS - DISTRIBUTION & SOFT
# ============================================================================

snippet constraint_soft "Soft Constraint"
	constraint ${1:name}_c {
		soft ${2:variable} == ${3:value};
	}

snippet constraint_dist "Distribution (Standard :=)"
	// := Operator: Weight applies to EACH item/value
	constraint ${1:name}_c {
		${2:var} dist {
			${3:val1} := ${4:weight1},
			${5:val2} := ${6:weight2},
			[${7:min}:${8:max}] := ${9:weight3}
		};
	}

snippet constraint_dist_range "Distribution (Range :/)"
	// :/ Operator: Weight is SPLIT across the range
	constraint ${1:name}_c {
		${2:var} dist {
			[${3:min}:${4:max}] :/ ${5:total_weight}
		};
	}

snippet constraint_dist_equal "Distribution (Equal Probability)"
	constraint ${1:name}_c {
		${2:var} dist {
			${3:val1} := 1,
			${4:val2} := 1
		};
	}

# ============================================================================
# CONSTRAINTS - LOGIC & FLOW
# ============================================================================

snippet constraint_implication "Implication (->)"
	constraint ${1:name}_c {
		(${2:condition}) -> (${3:constraint_expr});
	}

snippet constraint_if "If-Else Constraint"
	constraint ${1:name}_c {
		if (${2:condition}) {
			${3:constraint_true};
		} else {
			${4:constraint_false};
		}
	}

snippet constraint_foreach "Foreach Constraint"
	constraint ${1:name}_c {
		foreach (${2:array}[i]) {
			${2}[i] ${3:inside {[0:255]}};
		}
	}

snippet constraint_unique "Unique Constraint (SV 2012)"
	constraint ${1:name}_c {
		unique { ${2:list_of_vars_or_array} };
	}

snippet constraint_order "Solve...Before"
	constraint ${1:order}_c {
		solve ${2:control_var} before ${3:dependent_var};
	}

# ============================================================================
# INLINE RANDOMIZATION (Scope Randomize)
# ============================================================================

snippet randomize_scope "std::randomize (Scope/Variable)"
	if (!std::randomize(${1:variable}) with {
		$1 inside {[${2:min}:${3:max}]};
	}) begin
		\`uvm_error("RND", "Randomization failed for $1")
	end

# ============================================================================
# CROSS COVERAGE (Advanced Filtering)
# ============================================================================

snippet cross_basic "Basic Cross"
	${1:name}_x: cross ${2:cp1}, ${3:cp2};

snippet cross_binsof "Cross with binsof (Ignore specific combos)"
	${1:name}_x: cross ${2:cp1}, ${3:cp2} {
		// Ignore cases where cp1 is 'val'
		ignore_bins ${4:ign_name} = binsof($2) intersect {${5:val}};
	}

snippet cross_iff "Cross with iff (Conditional)"
	${1:name}_x: cross ${2:cp1}, ${3:cp2} iff (${4:enable_signal});
# ============================================================================
# SYSTEM FUNCTIONS (Bit & Array Query)
# ============================================================================

snippet countones "Count Ones ($countones)"
	\$countones(${1:expr})

snippet countbits "Count Bits ($countbits)"
	// Count number of bits matching the mask (e.g., '0, '1, 'x, 'z)
	\$countbits(${1:expr}, ${2:'1})

snippet onehot "One-hot Check ($onehot)"
	// True if exactly one bit is 1
	\$onehot(${1:expr})

snippet onehot0 "One-hot-or-Zero Check ($onehot0)"
	// True if zero or one bit is 1
	\$onehot0(${1:expr})

snippet isunknown "Unknown Check ($isunknown)"
	// True if any bit is X or Z
	\$isunknown(${1:expr})

snippet bits "Bit Width ($bits)"
	\$bits(${1:type_or_expr})

snippet clog2 "Ceiling Log2 (Calc Width)"
	// Standard way to calculate address width: localparam AW = $clog2(DEPTH);
	\$clog2(${1:depth})

snippet typename "Type Name String ($typename)"
	\$typename(${1:expr})

# --- Array Query Functions ---

snippet size "Array Size ($size)"
	${1:array}.size()

snippet high "High Index ($high)"
	\$high(${1:array}, ${2:0})

snippet low "Low Index ($low)"
	\$low(${1:array}, ${2:0})

snippet dimensions "Dimensions ($dimensions)"
	\$dimensions(${1:array})

# ============================================================================
# SEVERITY SYSTEM TASKS (RTL & TB)
# ============================================================================

snippet fatal "Fatal Error (Stops Sim)"
	\$fatal(${1:1}, "${2:Message}: %${3:d}", ${4:arg});

snippet error "Error (Counted)"
	\$error("${1:Message}: %${2:d}", ${3:arg});

snippet warning "Warning"
	\$warning("${1:Message}: %${2:d}", ${3:arg});

snippet info "Info (Message)"
	\$info("${1:Message}: %${2:d}", ${3:arg});

# ============================================================================
# UVM HDL ACCESS (Backdoor Access)
# Requires: import uvm_pkg::*;
# ============================================================================

snippet uvm_hdl_read "UVM HDL Read (Safe)"
	${1:val_var} = 0;
	if (!uvm_hdl_read("${2:top.dut.signal}", $1)) begin
		\`uvm_error("HDL_READ", "Failed to read path: $2")
	end

snippet uvm_hdl_force "UVM HDL Force (Freeze Value)"
	// Force holds the value (like Verilog force) until release
	if (!uvm_hdl_force("${1:top.dut.signal}", ${2:value})) begin
		\`uvm_error("HDL_FORCE", "Failed to force path: $1")
	end

snippet uvm_hdl_deposit "UVM HDL Deposit (Set Value)"
	// Deposit sets value now, but can be overwritten by DUT drivers
	if (!uvm_hdl_deposit("${1:top.dut.signal}", ${2:value})) begin
		\`uvm_error("HDL_DEP", "Failed to deposit path: $1")
	end

snippet uvm_hdl_release "UVM HDL Release"
	if (!uvm_hdl_release("${1:top.dut.signal}")) begin
		\`uvm_error("HDL_REL", "Failed to release path: $1")
	end

snippet uvm_hdl_check "UVM HDL Check Path Exists"
	if (uvm_hdl_check_path("${1:top.dut.signal}")) begin
		${2:// Path exists logic}
	end else begin
		\`uvm_warning("HDL_CHECK", "Path does not exist: $1")
	end
# ============================================================================
# SIMULATION CONTROL TASKS
# ============================================================================

snippet finish "Finish Simulation ($finish)"
	// 0: none, 1: time, 2: time + memory
	\$finish(${1:2});

snippet stop "Stop Simulation / Breakpoint ($stop)"
	// Enters interactive mode (breakpoint)
	\$stop(${1:2});

snippet timeformat "Set Time Format"
	// unit_num, precision, suffix, min_field_width
	\$timeformat(${1:-9}, ${2:3}, " ${3:ns}", ${4:8});

snippet save "Save Simulation State"
	\$save("${1:checkpoint_name}");

snippet restart "Restart Simulation"
	\$restart("${1:checkpoint_name}");

snippet exit "Exit Simulator (Aggressive)"
	\$exit;

# ============================================================================
# EVENT CONTROL
# ============================================================================

snippet wait_order "Wait Order (Strict)"
	wait_order(${1:a}, ${2:b}, ${3:c})
		else \`uvm_error("ORDER", "Events out of order");

snippet wait_trigger "Wait Event"
	@(${1:event_name});

snippet trigger "Trigger Event"
	-> ${1:event_name};

snippet trigger_nonblock "Trigger Event (Non-blocking)"
	->> ${1:event_name};


