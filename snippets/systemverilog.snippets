# ============================================================================
# OBJECTION UTILITIES
# ============================================================================

snippet objection "Raise/Drop Objection Block"
	phase.raise_objection(this);
	\`uvm_info(get_name(), "Phase started, objection raised", UVM_LOW)
	
	${1:// Sequence or Delay}
	
	phase.drop_objection(this);
	\`uvm_info(get_name(), "Phase finished, objection dropped", UVM_LOW)

snippet objection_raise "Raise Objection"
	phase.raise_objection(this, "${1:Reason}");

snippet objection_drop "Drop Objection"
	phase.drop_objection(this, "${1:Reason}");
# ============================================================================
# UVM CALLBACKS (Hook & Injection)
# Flow: Define Class -> Register in Driver -> Call in Driver -> Add in Test
# ============================================================================

# --- STEP 1: Define the Callback Class ---
snippet uvm_callback_define "Define Callback Class"
	typedef class ${2:driver_class_name};
	
	class ${1:$TM_FILENAME_BASE} extends uvm_callback;
		\`uvm_object_utils($1)
		
		function new(string name = "$1");
			super.new(name);
		endfunction
		
		// Virtual methods for the driver to call
		virtual task pre_drive($2 drv, ${3:seq_item_type} item);
		endtask
		
		virtual task post_drive($2 drv, $3 item);
		endtask
		
	endclass : $1

# --- STEP 2: Register & Call (Inside Driver) ---
# Use this INSIDE your Driver Class

snippet uvm_callback_register "Register Callback (Inside Driver)"
	// 1. Register the callback type with this component type
	\`uvm_register_cb(${1:$TM_FILENAME_BASE}, ${2:callback_class_name})
	
	// 2. Define typedef for easier usage (Optional but recommended)
	typedef uvm_callbacks#($1, $2) cb_pool;

snippet uvm_callback_hook "Call Callback (Inside Driver Run Phase)"
	// Execute the callback hook
	\`uvm_do_callbacks(${1:driver_class}, ${2:cb_class}, ${3:method_name}(this, req))

# --- STEP 3: Implement & Add (Inside Test/Env) ---

snippet uvm_callback_impl "Implement Specific Callback"
	class ${1:err_inject}_cb extends ${2:base_cb_class};
		\`uvm_object_utils($1_cb)
		
		function new(string name = "$1_cb");
			super.new(name);
		endfunction
		
		virtual task ${3:pre_drive}(${4:driver_type} drv, ${5:item_type} item);
			// Inject Error or Modify Item
			\`uvm_info("CB", "Injecting Error via Callback", UVM_LOW)
			${6:item.data = 'hFFFF;}
		endtask
	endclass : $1_cb

snippet uvm_callback_add "Add Callback to Instance (In Test)"
	// Instantiate and register the callback
	${1:my_cb} = $1::type_id::create("$1");
	uvm_callbacks#(${2:driver_type}, ${3:cb_base_type})::add(${4:drv_inst}, $1);

# ============================================================================
# UVM FUNCTIONAL COVERAGE
# Pattern: uvm_subscriber -> covergroup -> sample()
# ============================================================================

# --- Complete Coverage Component ---

snippet uvm_cov_subscriber "UVM Coverage Subscriber Component"
	class ${1:$TM_FILENAME_BASE} extends uvm_subscriber #(${2:transaction_type});
		\`uvm_component_utils($1)
		
		// Transaction handle for sampling
		$2 ${3:cov_trans};
		
		// Covergroup Definition
		covergroup ${4:cg_trans};
			option.per_instance = 1;
			option.comment = "Coverage for $2";
			
			${5:cp_field}: coverpoint $3.${6:field_name} {
				bins ${7:all}[] = {[0:\$]};
			}
			// Add cross coverage here
			// cross $5, other_cp;
		endgroup : $4
		
		function new(string name = "$1", uvm_component parent);
			super.new(name, parent);
			$4 = new(); // Instantiate covergroup
		endfunction
		
		// Implementation of the pure virtual function from uvm_subscriber
		virtual function void write($2 t);
			// 1. Copy transaction handle
			$3 = t;
			// 2. Trigger sampling
			$4.sample();
		endfunction
		
	endclass : $1

# --- Individual Coverage Methods ---

snippet uvm_cov_write "Write Function (Sampling)"
	virtual function void write(${1:transaction_type} t);
		${2:m_trans} = t;
		${3:cg_inst}.sample();
	endfunction

snippet uvm_cov_sample "Manual Sample Function"
	function void sample_coverage(${1:args});
		${2:local_var} = $1;
		${3:cg_inst}.sample();
	endfunction

# --- Covergroup embedded in Class ---

snippet covergroup_class "Class-based Covergroup"
	covergroup ${1:cg_name} @(posedge ${2:vif.clk});
		option.per_instance = 1;
		
		${3:cp_name}: coverpoint ${4:variable} {
			bins ${5:low} = {0};
			bins ${6:high} = {1};
		}
	endgroup : $1
	
	// Remember to call '$1 = new();' in the class constructor!
# ============================================================================
# UVM MONITOR (Data Collector)
# ============================================================================

snippet uvm_monitor "UVM Monitor Component"
	class ${1:$TM_FILENAME_BASE} extends uvm_monitor;
		\`uvm_component_utils($1)
		
		// 1. Interface and Analysis Port
		virtual ${2:my_interface} vif;
		uvm_analysis_port #(${3:seq_item_type}) ap;
		
		function new(string name = "$1", uvm_component parent);
			super.new(name, parent);
			ap = new("ap", this);
		endfunction
		
		function void build_phase(uvm_phase phase);
			super.build_phase(phase);
			if (!uvm_config_db#(virtual $2)::get(this, "", "vif", vif))
				\`uvm_fatal("NOVIF", "Virtual interface not set for $1")
		endfunction
		
		task run_phase(uvm_phase phase);
			$3 item;
			forever begin
				// 2. Wait for bus activity and collect data
				collect_transfer(item);
				// 3. Broadcast to Scoreboard/Coverage
				ap.write(item);
			end
		endtask
		
		task collect_transfer(output $3 item);
			item = $3::type_id::create("item");
			@(posedge vif.clk);
			// TODO: Add protocol specific logic here
			// item.data = vif.data;
		endtask
		
	endclass : $1

# ============================================================================
# UVM REFERENCE MODEL / PREDICTOR
# Receives Input -> Calculates Expected Output -> Sends to Scoreboard
# ============================================================================

snippet uvm_ref_model "UVM Reference Model (Predictor)"
	class ${1:$TM_FILENAME_BASE} extends uvm_subscriber #(${2:input_item_type});
		\`uvm_component_utils($1)
		
		// Output Port to Scoreboard
		uvm_analysis_port #(${3:output_item_type}) ap;
		
		function new(string name = "$1", uvm_component parent);
			super.new(name, parent);
			ap = new("ap", this);
		endfunction
		
		// 1. Receive Input Transaction
		virtual function void write($2 t);
			$3 exp_tr;
			exp_tr = $3::type_id::create("exp_tr");
			
			// 2. Predict Result (Golden Model Logic)
			predict(t, exp_tr);
			
			// 3. Send Expected Transaction to Scoreboard
			ap.write(exp_tr);
		endfunction
		
		extern function void predict($2 inc, ref $3 out);
		
	endclass : $1
	
	function void $1::predict($2 inc, ref $3 out);
		// TODO: Implement reference logic
		// out.data = inc.addr + inc.data;
		out.copy(inc); // Default: pass-through
	endfunction

# ============================================================================
# UVM SCOREBOARD (Comparator)
# Uses TLM FIFOs to handle timing differences between DUT and RefModel
# ============================================================================

snippet uvm_scoreboard "UVM Scoreboard (with TLM FIFOs)"
	class ${1:$TM_FILENAME_BASE} extends uvm_scoreboard;
		\`uvm_component_utils($1)
		
		// Ports and FIFOs
		uvm_analysis_export #(${2:seq_item_type}) act_export; // From DUT Monitor
		uvm_analysis_export #($2) exp_export; // From Ref Model
		
		uvm_tlm_analysis_fifo #($2) act_fifo;
		uvm_tlm_analysis_fifo #($2) exp_fifo;
		
		int m_matches, m_mismatches;
		
		function new(string name = "$1", uvm_component parent);
			super.new(name, parent);
			m_matches = 0;
			m_mismatches = 0;
		endfunction
		
		function void build_phase(uvm_phase phase);
			super.build_phase(phase);
			act_export = new("act_export", this);
			exp_export = new("exp_export", this);
			act_fifo   = new("act_fifo", this);
			exp_fifo   = new("exp_fifo", this);
		endfunction
		
		function void connect_phase(uvm_phase phase);
			super.connect_phase(phase);
			// Connect Exports to FIFOs
			act_export.connect(act_fifo.analysis_export);
			exp_export.connect(exp_fifo.analysis_export);
		endfunction
		
		task run_phase(uvm_phase phase);
			$2 act_tr, exp_tr;
			forever begin
				// 1. Fetch transactions (Blocking until both available)
				fork
					act_fifo.get(act_tr);
					exp_fifo.get(exp_tr);
				join
				
				// 2. Compare
				if (act_tr.compare(exp_tr)) begin
					m_matches++;
					\`uvm_info("COMPARE", {"MATCH: ", act_tr.convert2string()}, UVM_HIGH)
				end else begin
					m_mismatches++;
					\`uvm_error("COMPARE", $sformatf("MISMATCH!\nExp: %s\nAct: %s", 
						exp_tr.convert2string(), act_tr.convert2string()))
				end
			end
		endtask
		
		function void report_phase(uvm_phase phase);
			super.report_phase(phase);
			\`uvm_info("SCB_REPORT", $sformatf("Matches: %0d, Mismatches: %0d", 
				m_matches, m_mismatches), UVM_LOW)
		endfunction
		
	endclass : $1

# ============================================================================
# CONNECTION HELPER (Paste inside Env connect_phase)
# ============================================================================

snippet uvm_connect_scb_ref "Connect Monitor-RefModel-Scoreboard"
	// 1. Input Monitor -> Ref Model
	${1:in_agent}.mon.ap.connect(${2:ref_mdl}.analysis_export);
	
	// 2. Ref Model (Expected) -> Scoreboard
	$2.ap.connect(${3:scb}.exp_export);
	
	// 3. Output Monitor (Actual) -> Scoreboard
	${4:out_agent}.mon.ap.connect($3.act_export);
	
	
	
