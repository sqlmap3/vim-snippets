# =============================================================================
# FSM TEMPLATE
# =============================================================================

snippet fsm "FSM template"
	typedef enum logic [${1:1}:0] {
	    ${2:IDLE}   = ${3:2'b00},
	    ${4:ACTIVE} = ${5:2'b01},
	    ${6:DONE}   = ${7:2'b10}
	} ${8:state}_t;
	
	$8_t current_state, next_state;
	
	always_ff @(posedge ${9:clk} or negedge ${10:rst_n}) begin
	    if (!$10)
	        current_state <= $2;
	    else
	        current_state <= next_state;
	end
	
	always_comb begin
	    next_state = current_state;
	    case (current_state)
	        $2:   ${11}
	        $4:   ${12}
	        $6:   ${13}
	        default: next_state = $2;
	    endcase
	end

# =============================================================================
# COMMON PATTERNS
# =============================================================================

snippet fifo "FIFO control"
	logic [${1:DEPTH_W}-1:0] wr_ptr, rd_ptr;
	logic [${2:DATA_W}-1:0] mem [2**$1];
	logic empty, full;
	
	assign empty = (wr_ptr == rd_ptr);
	assign full  = (wr_ptr + 1 == rd_ptr);

snippet handshake "Valid-ready handshake"
	logic ${1:valid}, ${2:ready};
	
	always_ff @(posedge ${3:clk} or negedge ${4:rst_n}) begin
	    if (!$4)
	        $1 <= 1'b0;
	    else if ($1 && $2)
	        $1 <= 1'b0;
	    else if (${5:condition})
	        $1 <= 1'b1;
	end

snippet assign "Assign"
	assign ${1:target} = ${2:expression};

# =============================================================================
# UVM COMPONENTS
# =============================================================================

snippet uvm_agent "UVM Agent"
	class ${1:`expand('%:t:r')`} extends uvm_agent;
	    `uvm_component_utils($1)
	
	    ${2:`substitute(expand('%:t:r'), '_agent$', '', '')`}_sequencer  sqr;
	    $2_driver     drv;
	    $2_monitor    mon;
	
	    uvm_active_passive_enum is_active = UVM_ACTIVE;
	
	    extern function new(string name = "$1", uvm_component parent = null);
	    extern virtual function void build_phase(uvm_phase phase);
	    extern virtual function void connect_phase(uvm_phase phase);
	
	endclass: $1
	
	function $1::new(string name = "$1", uvm_component parent = null);
	    super.new(name, parent);
	endfunction: new
	
	function void $1::build_phase(uvm_phase phase);
	    super.build_phase(phase);
	    
	    // Get configuration
	    if (!uvm_config_db#(uvm_active_passive_enum)::get(this, "", "is_active", is_active))
	        `uvm_info(get_name(), "is_active not configured, using default UVM_ACTIVE", UVM_MEDIUM)
	    
	    // Always create monitor
	    mon = $2_monitor::type_id::create("mon", this);
	    
	    // Create driver and sequencer only in active mode
	    if (is_active == UVM_ACTIVE) begin
	        sqr = $2_sequencer::type_id::create("sqr", this);
	        drv = $2_driver::type_id::create("drv", this);
	    end
	endfunction: build_phase
	
	function void $1::connect_phase(uvm_phase phase);
	    super.connect_phase(phase);
	    if (is_active == UVM_ACTIVE) begin
	        drv.seq_item_port.connect(sqr.seq_item_export);
	    end
	endfunction: connect_phase

snippet uvm_driver "UVM Driver"
	class ${1:`expand('%:t:r')`} extends uvm_driver #(${2:`substitute(expand('%:t:r'), '_driver$', '_item', '')`});
	    `uvm_component_utils($1)
	
	    virtual ${3:`substitute(expand('%:t:r'), '_driver$', '_if', '')`} vif;
	
	    extern function new(string name = "$1", uvm_component parent = null);
	    extern virtual function void build_phase(uvm_phase phase);
	    extern virtual task run_phase(uvm_phase phase);
	    extern virtual task drive_item($2 item);
	
	endclass: $1
	
	function $1::new(string name = "$1", uvm_component parent = null);
	    super.new(name, parent);
	endfunction: new
	
	function void $1::build_phase(uvm_phase phase);
	    super.build_phase(phase);
	    if (!uvm_config_db#(virtual $3)::get(this, "", "vif", vif))
	        `uvm_fatal(get_name(), "Virtual interface not found!")
	endfunction: build_phase
	
	task $1::run_phase(uvm_phase phase);
	    forever begin
	        seq_item_port.get_next_item(req);
	        drive_item(req);
	        seq_item_port.item_done();
	    end
	endtask: run_phase
	
	task $1::drive_item($2 item);
	    // TODO: Implement protocol-specific driving
	    // Example:
	    // @(posedge vif.clk);
	    // vif.data <= item.data;
	    ${0}
	endtask: drive_item

snippet uvm_monitor "UVM Monitor"
	class ${1:`expand('%:t:r')`} extends uvm_monitor;
	    `uvm_component_utils($1)
	
	    uvm_analysis_port #(${2:`substitute(expand('%:t:r'), '_monitor$', '_item', '')`}) ap;
	    virtual ${3:`substitute(expand('%:t:r'), '_monitor$', '_if', '')`} vif;
	
	    extern function new(string name = "$1", uvm_component parent = null);
	    extern virtual function void build_phase(uvm_phase phase);
	    extern virtual task run_phase(uvm_phase phase);
	    extern virtual task collect_transaction(output $2 item);
	
	endclass: $1
	
	function $1::new(string name = "$1", uvm_component parent = null);
	    super.new(name, parent);
	endfunction: new
	
	function void $1::build_phase(uvm_phase phase);
	    super.build_phase(phase);
	    ap = new("ap", this);
	    if (!uvm_config_db#(virtual $3)::get(this, "", "vif", vif))
	        `uvm_fatal(get_name(), "Virtual interface not found!")
	endfunction: build_phase
	
	task $1::run_phase(uvm_phase phase);
	    forever begin
	        $2 item;
	        collect_transaction(item);
	        `uvm_info(get_name(), item.convert2string(), UVM_HIGH)
	        ap.write(item);
	    end
	endtask: run_phase
	
	task $1::collect_transaction(output $2 item);
	    item = $2::type_id::create("item");
	    // TODO: Implement protocol-specific monitoring
	    // Example:
	    // @(posedge vif.clk);
	    // if (vif.valid && vif.ready) begin
	    //   item.data = vif.data;
	    // end
	    ${0}
	endtask: collect_transaction

snippet uvm_sequencer "UVM Sequencer"
	class ${1:`expand('%:t:r')`} extends uvm_sequencer #(${2:`substitute(expand('%:t:r'), '_sequencer$', '_item', '')`});
	    `uvm_component_utils($1)
	
	    extern function new(string name = "$1", uvm_component parent = null);
	
	endclass: $1
	
	function $1::new(string name = "$1", uvm_component parent = null);
	    super.new(name, parent);
	endfunction: new

snippet uvm_sequence "UVM Sequence"
	class ${1:`expand('%:t:r')`} extends uvm_sequence #(${2:`substitute(expand('%:t:r'), '_\(seq\|sequence\)$', '_item', '')`});
	    `uvm_object_utils($1)
	
	    // Sequence properties
	    rand int unsigned num_trans = ${3:10};
	
	    extern function new(string name = "$1");
	    extern virtual task body();
	    extern virtual task pre_body();
	    extern virtual task post_body();
	
	endclass: $1
	
	function $1::new(string name = "$1");
	    super.new(name);
	endfunction: new
	
	task $1::pre_body();
	    // Setup before sequence execution
	    `uvm_info(get_type_name(), $sformatf("Starting sequence with %0d transactions", num_trans), UVM_MEDIUM)
	endtask: pre_body
	
	task $1::body();
	    repeat (num_trans) begin
	        `uvm_do(req)
	    end
	endtask: body
	
	task $1::post_body();
	    // Cleanup after sequence execution
	    `uvm_info(get_type_name(), "Sequence completed", UVM_MEDIUM)
	endtask: post_body

snippet component_param sequence "UVM Sequence (parameterized)"
	// ============================================================================
	// UVM SEQUENCE - Parameterized Version
	// ============================================================================
	class ${1:`expand('%:t:r')`} #(
	    parameter int ${2:DATA_WIDTH} = ${3:32}
	) extends uvm_sequence #(${4:`substitute(expand('%:t:r'), '_\(seq\|sequence\)$', '_item', '')`}#($2));
	    `uvm_object_param_utils($1#($2))
	
	    typedef $4#($2) item_t;
	    rand int unsigned num_trans = ${5:10};
	
	    extern function new(string name = "$1");
	    extern virtual task body();
	
	endclass: $1
	
	function $1#($2)::new(string name = "$1");
	    super.new(name);
	endfunction: new
	
	task $1#($2)::body();
	    repeat (num_trans) begin
	        `uvm_do(req)
	    end
	endtask: body

snippet sequence_item "UVM Sequence Item (Transaction)"
	// ============================================================================
	// UVM SEQUENCE ITEM - Transaction Object (UVM Cookbook 5.2)
	// ============================================================================
	// Purpose:
	//   1. Define transaction fields
	//   2. Add constraints for randomization
	//   3. Implement utility methods
	//
	// Required Methods:
	//   - do_copy()    - Deep copy
	//   - do_compare() - Field comparison
	//   - do_print()   - Print fields
	//   - convert2string() - String representation
	//
	// Constraints:
	//   - Use constraints to limit random values
	//   - Use rand/randc for randomization
	//
	// Example:
	//   class my_item extends uvm_sequence_item;
	//     rand bit [7:0] addr;
	//     rand bit [31:0] data;
	//     
	//     constraint addr_c { addr inside {[0:127]}; }
	//     constraint data_c { data < 1000; }
	//   endclass
	// ============================================================================
	class ${1:`expand('%:t:r')`} extends uvm_sequence_item;
	    `uvm_object_utils($1)
	
	    // Transaction fields
	    rand bit [${2:7}:0] ${3:addr};
	    rand bit [${4:31}:0] ${5:data};
	    ${6}
	
	    // Constraints
	    constraint ${7:valid}_c {
	        ${8}
	    }
	
	    extern function new(string name = "$1");
	    extern function void do_copy(uvm_object rhs);
	    extern function bit do_compare(uvm_object rhs, uvm_comparer comparer);
	    extern function void do_print(uvm_printer printer);
	    extern function string convert2string();
	
	endclass: $1
	
	function $1::new(string name = "$1");
	    super.new(name);
	endfunction: new
	
	function void $1::do_copy(uvm_object rhs);
	    $1 rhs_;
	    if (!$cast(rhs_, rhs))
	        `uvm_fatal(get_type_name(), "Cast failed in do_copy")
	    super.do_copy(rhs);
	    this.$3 = rhs_.$3;
	    this.$5 = rhs_.$5;
	endfunction: do_copy
	
	function bit $1::do_compare(uvm_object rhs, uvm_comparer comparer);
	    $1 rhs_;
	    if (!$cast(rhs_, rhs))
	        return 0;
	    return (super.do_compare(rhs, comparer) &&
	            (this.$3 == rhs_.$3) &&
	            (this.$5 == rhs_.$5));
	endfunction: do_compare
	
	function void $1::do_print(uvm_printer printer);
	    super.do_print(printer);
	    printer.print_field("$3", this.$3, $2+1);
	    printer.print_field("$5", this.$5, $4+1);
	endfunction: do_print
	
	function string $1::convert2string();
	    return $sformatf("$3=0x%0h, $5=0x%0h", $3, $5);
	endfunction: convert2string

# =============================================================================
# SYSTEMVERILOG ASSERTIONS (SVA) - COMPREHENSIVE
# =============================================================================

snippet sva_property "SVA Property Definition (Detailed)"
	// ============================================================================
	// SVA PROPERTY - Assertion Property (IEEE 1800-2017 Chapter 16)
	// ============================================================================
	// Purpose: Define temporal property for verification
	//
	// Property Structure:
	//   property name;
	//     @(posedge clk) disable iff (reset)
	//     antecedent |-> consequent;
	//   endproperty
	//
	// Implication Operators:
	//   |->  Overlapping (consequent checked same cycle)
	//   |=>  Non-overlapping (consequent checked next cycle)
	//
	// Sequence Operators:
	//   ##n  - Delay by n cycles
	//   ##[m:n] - Delay between m and n cycles
	//   [*n] - Repeat exactly n times
	//   [*m:n] - Repeat between m and n times
	//   [->n] - Goto repetition (non-consecutive)
	//   [=n]  - Non-consecutive repetition
	//
	// Example:
	//   property req_ack;
	//     @(posedge clk) disable iff (rst)
	//     req |-> ##[1:3] ack;
	//   endproperty
	// ============================================================================
	property ${1:prop_name};
	    @(posedge ${2:clk}) disable iff (${3:!rst_n})
	    ${4:antecedent} |-> ${5:consequent};
	endproperty: $1
	
	${6:assert_}$1: assert property ($1)
	    else `uvm_error("ASSERT", $sformatf("$1 failed at %0t", $time))

snippet sva_sequence "SVA Sequence Definition"
	// ============================================================================
	// SVA SEQUENCE - Reusable Temporal Pattern
	// ============================================================================
	// Purpose: Define reusable sequence of events
	//
	// Common Patterns:
	//   - sig_rise: $rose(signal)
	//   - sig_fall: $fell(signal)
	//   - stable:   $stable(signal)
	//   - delay:    ##n (n cycles delay)
	//   - throughout: expr throughout seq
	//
	// Example:
	//   sequence handshake;
	//     valid ##1 ready;
	//   endsequence
	// ============================================================================
	sequence ${1:seq_name};
	    ${2:expression};
	endsequence: $1

snippet sva_implication "SVA Implication Examples"
	// Overlapping Implication (|->)
	// Consequent checked in same cycle as antecedent
	property ${1:overlap_prop};
	    @(posedge ${2:clk}) disable iff (${3:!rst_n})
	    ${4:req} |-> ${5:grant};  // If req this cycle, grant must be true this cycle
	endproperty
	
	// Non-overlapping Implication (|=>)
	// Consequent checked in next cycle
	property ${6:nonoverlap_prop};
	    @(posedge $2) disable iff ($3)
	    $4 |=> $5;  // If req this cycle, grant must be true next cycle
	endproperty

snippet sva_delay "SVA Delay Operators"
	// ============================================================================
	// SVA DELAY OPERATORS
	// ============================================================================
	// Fixed Delay: ##n
	property ${1:fixed_delay};
	    @(posedge ${2:clk})
	    ${3:req} |-> ##${4:2} ${5:ack};  // ack exactly 2 cycles after req
	endproperty
	
	// Range Delay: ##[m:n]
	property ${6:range_delay};
	    @(posedge $2)
	    $3 |-> ##[${7:1}:${8:5}] $5;  // ack within 1-5 cycles after req
	endproperty
	
	// Unbounded Delay: ##[1:$]
	property ${9:unbounded_delay};
	    @(posedge $2)
	    $3 |-> ##[1:$] $5;  // ack eventually after req
	endproperty

snippet sva_repetition "SVA Repetition Operators"
	// ============================================================================
	// SVA REPETITION OPERATORS
	// ============================================================================
	// Consecutive Repetition: [*n]
	property ${1:consecutive_rep};
	    @(posedge ${2:clk})
	    ${3:busy}[*${4:3}] ##1 ${5:done};  // busy for exactly 3 cycles, then done
	endproperty
	
	// Range Repetition: [*m:n]
	property ${6:range_rep};
	    @(posedge $2)
	    $3[*${7:2}:${8:5}] ##1 $5;  // busy for 2-5 cycles, then done
	endproperty
	
	// Goto Repetition: [->n]
	property ${9:goto_rep};
	    @(posedge $2)
	    ${10:valid}[->3] ##1 ${11:complete};  // valid high 3 times (non-consecutive), then complete
	endproperty
	
	// Non-consecutive Repetition: [=n]
	property ${12:noncons_rep};
	    @(posedge $2)
	    $10[=3];  // valid high 3 times (may be non-consecutive)
	endproperty

snippet sva_throughout "SVA Throughout Operator"
	// ============================================================================
	// SVA THROUGHOUT - Condition Must Hold During Sequence
	// ============================================================================
	property ${1:throughout_prop};
	    @(posedge ${2:clk})
	    ${3:enable} throughout (${4:req} ##[1:5] ${5:ack});
	    // enable must remain high from req until ack
	endproperty

snippet sva_advanced "SVA Advanced Patterns"
	// ============================================================================
	// ADVANCED SVA PATTERNS
	// ============================================================================
	
	// 1. Request-Acknowledge with Timeout
	property ${1:req_ack_timeout};
	    @(posedge ${2:clk}) disable iff (${3:!rst_n})
	    ${4:req} |-> ##[1:${5:10}] ${6:ack};
	endproperty
	
	// 2. Mutual Exclusion
	property ${7:mutex};
	    @(posedge $2) disable iff ($3)
	    ${8:sig_a} |-> !${9:sig_b};
	endproperty
	
	// 3. FIFO Full/Empty Relationship
	property ${10:fifo_full_empty};
	    @(posedge $2) disable iff ($3)
	    !(${11:full} && ${12:empty});
	endproperty
	
	// 4. Handshake Protocol
	property ${13:handshake};
	    @(posedge $2) disable iff ($3)
	    ${14:valid} && ${15:ready} |=> !${16:valid} || ${17:new_data};
	endproperty
	
	// 5. One-Hot Encoding
	property ${18:onehot};
	    @(posedge $2)
	    $onehot(${19:state});
	endproperty

snippet sva_cover "SVA COVER - Functional Coverage via Assertions"
	// ============================================================================
	// SVA COVER - Functional Coverage via Assertions
	// ============================================================================
	// Purpose: Verify that certain scenarios occur during simulation
	//
	// Usage:
	//   cover property (prop_name);
	//
	// Reports when property matches, useful for:
	//   - Verifying corner cases occur
	//   - Checking stimulus coverage
	//   - Debug: Did this scenario happen?
	// ============================================================================
	property ${1:cover_prop};
	    @(posedge ${2:clk})
	    ${3:condition};
	endproperty
	
	cover_$1: cover property ($1)
	    `uvm_info("COVER", $sformatf("$1 covered at %0t", $time), UVM_MEDIUM)

snippet sva_assume "SVA Assume Property"
	// ============================================================================
	// SVA ASSUME - Input Constraints for Formal Verification
	// ============================================================================
	// Purpose: Constrain input behavior for formal tools
	//
	// Usage:
	//   assume property (input_constraint);
	//
	// Difference from assert:
	//   - assert: Check DUT behavior (outputs)
	//   - assume: Constrain environment (inputs)
	// ============================================================================
	property ${1:assume_prop};
	    @(posedge ${2:clk})
	    ${3:input_constraint};
	endproperty
	
	assume_$1: assume property ($1);

snippet sva_concurrent "SVA Concurrent Assertion"
	// ============================================================================
	// CONCURRENT ASSERTION - Clocked Assertion
	// ============================================================================
	// Evaluated continuously at clock edges
	// Use for protocol checking, temporal properties
	// ============================================================================
	${1:assert_name}: assert property (
	    @(posedge ${2:clk}) disable iff (${3:!rst_n})
	    ${4:property_expression}
	) else `uvm_error("ASSERT", "$1 failed");

snippet sva_immediate "SVA Immediate Assertion"
	// ============================================================================
	// IMMEDIATE ASSERTION - Procedural Assertion
	// ============================================================================
	// Evaluated immediately like procedural code
	// Use for: function inputs, internal checks, constraints
	// ============================================================================
	assert (${1:condition}) else `uvm_error("ASSERT", "${2:Assertion failed}");

snippet sva_system "SVA System Functions"
	// ============================================================================
	// SVA SYSTEM FUNCTIONS
	// ============================================================================
	
	// $rose - Detects 0->1 transition
	property ${1:rose_detect};
	    @(posedge ${2:clk})
	    $rose(${3:signal}) |-> ${4:action};
	endproperty
	
	// $fell - Detects 1->0 transition
	property ${5:fell_detect};
	    @(posedge $2)
	    $fell($3) |-> $4;
	endproperty
	
	// $stable - Signal unchanged
	property ${6:stable_check};
	    @(posedge $2)
	    ${7:hold} |-> $stable($3);
	endproperty
	
	// $past - Previous value
	property ${8:past_check};
	    @(posedge $2)
	    ${9:valid} |-> ${10:data} == $past(${11:prev_data});
	endproperty
	
	// $onehot - Exactly one bit high
	property ${12:onehot_check};
	    @(posedge $2)
	    $onehot(${13:state_vector});
	endproperty
	
	// $onehot0 - At most one bit high
	property ${14:onehot0_check};
	    @(posedge $2)
	    $onehot0($13);
	endproperty
	
	// $isunknown - Check for X/Z
	property ${15:unknown_check};
	    @(posedge $2)
	    !$isunknown($3);
	endproperty

snippet sva_fifo "SVA FIFO Protocol Assertions"
	// ============================================================================
	// COMPLETE FIFO ASSERTION SUITE
	// ============================================================================
	
	// 1. No write when full
	property ${1:no_write_when_full};
	    @(posedge ${2:clk}) disable iff (${3:!rst_n})
	    ${4:full} |-> !${5:wr_en};
	endproperty
	assert_$1: assert property ($1);
	
	// 2. No read when empty
	property ${6:no_read_when_empty};
	    @(posedge $2) disable iff ($3)
	    ${7:empty} |-> !${8:rd_en};
	endproperty
	assert_$6: assert property ($6);
	
	// 3. Write increments count (when not full)
	property ${9:write_inc_count};
	    @(posedge $2) disable iff ($3)
	    $5 && !$4 |=> ${10:count} == $past($10) + 1;
	endproperty
	assert_$9: assert property ($9);
	
	// 4. Read decrements count (when not empty)
	property ${11:read_dec_count};
	    @(posedge $2) disable iff ($3)
	    $8 && !$7 |=> $10 == $past($10) - 1;
	endproperty
	assert_$11: assert property ($11);
	
	// 5. Full and empty are mutually exclusive
	property ${12:full_empty_mutex};
	    @(posedge $2)
	    !($4 && $7);
	endproperty
	assert_$12: assert property ($12);

snippet sva_axi "SVA AXI Protocol Assertions"
	// ============================================================================
	// AXI4 PROTOCOL ASSERTION EXAMPLES
	// ============================================================================
	
	// 1. Valid-Ready Handshake (AXI Rule)
	property ${1:axi_valid_stable};
	    @(posedge ${2:clk}) disable iff (${3:!rst_n})
	    ${4:valid} && !${5:ready} |=> $stable($4) && $stable(${6:data});
	endproperty
	assert_$1: assert property ($1)
	    else `uvm_error("AXI", "VALID/data must remain stable until READY");
	
	// 2. BVALID follows WLAST and WREADY
	property ${7:axi_bvalid_after_wlast};
	    @(posedge $2) disable iff ($3)
	    ${8:wlast} && ${9:wready} |-> ##[1:${10:16}] ${11:bvalid};
	endproperty
	assert_$7: assert property ($7);
	
	// 3. RVALID must not be dependent on RREADY
	property ${12:axi_rvalid_independent};
	    @(posedge $2) disable iff ($3)
	    ${13:rvalid} |-> ${13:rvalid} throughout (##[0:$] ${14:rready});
	endproperty
	assert_$12: assert property ($12);

# =============================================================================
# MACROS AND PREPROCESSOR (IEEE 1800-2012 Section 22)
# =============================================================================

snippet macro_define "Define macro with parameters"
	\`define ${1:MACRO_NAME}(${2:args}) \\
	    ${3:macro body}

snippet macro_stringify "`\" stringify operator"
	\`define ${1:TO_STRING}(${2:x}) \`"${2}\`"

snippet macro_concat "`` token pasting operator"
	\`define ${1:CONCAT}(${2:a}, ${3:b}) ${2}\`\`${3}

snippet macro_ifdef_block "ifdef-else-endif block"
	\`ifdef ${1:MACRO_NAME}
	    ${2:code when defined}
	\`else
	    ${3:code when not defined}
	\`endif

snippet macro_ifndef_block "ifndef-else-endif block"
	\`ifndef ${1:MACRO_NAME}
	    ${2:code when not defined}
	\`else
	    ${3:code when defined}
	\`endif

snippet macro_undef "Undefine macro"
	\`undef ${1:MACRO_NAME}

snippet macro_line "Line directive"
	\`line ${1:line_number} "${2:filename}" ${3:level}

snippet macro_default "Default nettype directive"
	\`default_nettype ${1:wire}

snippet macro_resetall "Reset all compiler directives"
	\`resetall

snippet macro_celldefine "Cell define block"
	\`celldefine
	${1}
	\`endcelldefine

snippet macro_pragma "Pragma directive"
	\`pragma ${1:pragma_name} ${2:pragma_value}

snippet macro_begin_keywords "Begin keywords directive"
	\`begin_keywords "${1:1800-2012}"
	${2}
	\`end_keywords

# =============================================================================
# COMMON UVM MACROS
# =============================================================================

snippet uvm_info_macro "UVM_INFO macro usage"
	\`uvm_info("${1:ID}", $sformatf("${2:Message: %s}", ${3:arg}), ${4:UVM_MEDIUM})

snippet uvm_warning_macro "UVM_WARNING macro usage"
	\`uvm_warning("${1:ID}", $sformatf("${2:Message: %s}", ${3:arg}))

snippet uvm_error_macro "UVM_ERROR macro usage"
	\`uvm_error("${1:ID}", $sformatf("${2:Message: %s}", ${3:arg}))

snippet uvm_fatal_macro "UVM_FATAL macro usage"
	\`uvm_fatal("${1:ID}", $sformatf("${2:Message: %s}", ${3:arg}))

snippet uvm_do_macro "UVM_DO macro"
	\`uvm_do(${1:sequence_item})

snippet uvm_do_with_macro "UVM_DO_WITH macro"
	\`uvm_do_with(${1:sequence_item}, {
	    ${2:constraints}
	})

snippet uvm_create_macro "UVM_CREATE macro"
	\`uvm_create(${1:sequence_item})

snippet uvm_send_macro "UVM_SEND macro"
	\`uvm_send(${1:sequence_item})

snippet uvm_rand_send_macro "UVM_RAND_SEND macro"
	\`uvm_rand_send(${1:sequence_item})

snippet uvm_rand_send_with_macro "UVM_RAND_SEND_WITH macro"
	\`uvm_rand_send_with(${1:sequence_item}, {
	    ${2:constraints}
	})

snippet uvm_field_int "UVM_FIELD_INT macro"
	\`uvm_field_int(${1:field_name}, ${2:UVM_DEFAULT})

snippet uvm_field_object "UVM_FIELD_OBJECT macro"
	\`uvm_field_object(${1:field_name}, ${2:UVM_DEFAULT})

snippet uvm_field_string "UVM_FIELD_STRING macro"
	\`uvm_field_string(${1:field_name}, ${2:UVM_DEFAULT})

snippet uvm_field_enum "UVM_FIELD_ENUM macro"
	\`uvm_field_enum(${1:enum_type}, ${2:field_name}, ${3:UVM_DEFAULT})

snippet uvm_field_array_int "UVM_FIELD_ARRAY_INT macro"
	\`uvm_field_array_int(${1:field_name}, ${2:UVM_DEFAULT})

snippet uvm_field_sarray_int "UVM_FIELD_SARRAY_INT macro"
	\`uvm_field_sarray_int(${1:field_name}, ${2:UVM_DEFAULT})

snippet uvm_field_queue "UVM_FIELD_QUEUE macro"
	\`uvm_field_queue_${1:int}(${2:field_name}, ${3:UVM_DEFAULT})

snippet uvm_field_aa "UVM_FIELD_AA macro"
	\`uvm_field_aa_${1:int}_${2:string}(${3:field_name}, ${4:UVM_DEFAULT})

# =============================================================================
# COMMON UTILITY MACROS
# =============================================================================

snippet macro_min "MIN macro"
	\`define MIN(a, b) (((a) < (b)) ? (a) : (b))

snippet macro_max "MAX macro"
	\`define MAX(a, b) (((a) > (b)) ? (a) : (b))

snippet macro_abs "ABS macro"
	\`define ABS(x) (((x) < 0) ? -(x) : (x))

snippet macro_clamp "CLAMP macro"
	\`define CLAMP(x, min, max) (((x) < (min)) ? (min) : (((x) > (max)) ? (max) : (x)))

snippet macro_swap "SWAP macro"
	\`define SWAP(a, b, tmp) \\
	    tmp = a; \\
	    a = b; \\
	    b = tmp;

snippet macro_bit_width "BIT_WIDTH calculation macro"
	\`define BIT_WIDTH(x) ($clog2(x))

snippet macro_is_power_of_2 "IS_POWER_OF_2 check macro"
	\`define IS_POWER_OF_2(x) (((x) != 0) && (((x) & ((x) - 1)) == 0))

snippet macro_align_up "ALIGN_UP macro"
	\`define ALIGN_UP(x, align) ((((x) + (align) - 1) / (align)) * (align))

snippet macro_div_round_up "DIV_ROUND_UP macro"
	\`define DIV_ROUND_UP(x, y) (((x) + (y) - 1) / (y))

# =============================================================================
# VERIFICATION MACROS
# =============================================================================

snippet macro_check_fatal "CHECK_FATAL macro"
	\`define CHECK_FATAL(cond, msg) \\
	    if (!(cond)) begin \\
	        \$fatal(1, msg); \\
	    end

snippet macro_check_error "CHECK_ERROR macro"
	\`define CHECK_ERROR(cond, msg) \\
	    if (!(cond)) begin \\
	        \$error(msg); \\
	    end

snippet macro_check_warning "CHECK_WARNING macro"
	\`define CHECK_WARNING(cond, msg) \\
	    if (!(cond)) begin \\
	        \$warning(msg); \\
	    end

snippet macro_assert "ASSERT macro"
	\`define ASSERT(cond) \\
	    assert(cond) else \$error("Assertion failed: \`"cond\`" at %m")

snippet macro_cover "COVER macro"
	\`define COVER(name, cond) \\
	    cover property (@(posedge clk) cond) \\
	        \$display("Coverage: name hit at %t", \$time);

# =============================================================================
# DEBUG MACROS
# =============================================================================

snippet macro_debug "DEBUG print macro"
	\`ifdef DEBUG
	    \`define DEBUG_PRINT(msg) \$display("[DEBUG] %t: msg", \$time)
	\`else
	    \`define DEBUG_PRINT(msg)
	\`endif

snippet macro_verbose "VERBOSE print macro"
	\`ifdef VERBOSE
	    \`define VERBOSE_PRINT(level, msg) \\
	        if (verbose_level >= level) \$display("[VERBOSE] msg")
	\`else
	    \`define VERBOSE_PRINT(level, msg)
	\`endif

snippet macro_trace "TRACE macro"
	\`define TRACE(msg) \$display("[TRACE] %t %m: msg", \$time)

snippet macro_dump_vars "DUMP_VARS macro"
	\`define DUMP_VARS(var) \\
	    \$display("[DUMP] %t %m: \`"var\`" = %0d", \$time, var)

# =============================================================================
# REGISTER ACCESS MACROS
# =============================================================================

snippet macro_reg_write "REG_WRITE macro"
	\`define REG_WRITE(addr, data) \\
	    @(posedge clk); \\
	    reg_addr = addr; \\
	    reg_wdata = data; \\
	    reg_wr_en = 1'b1; \\
	    @(posedge clk); \\
	    reg_wr_en = 1'b0;

snippet macro_reg_read "REG_READ macro"
	\`define REG_READ(addr, data) \\
	    @(posedge clk); \\
	    reg_addr = addr; \\
	    reg_rd_en = 1'b1; \\
	    @(posedge clk); \\
	    data = reg_rdata; \\
	    reg_rd_en = 1'b0;

snippet macro_reg_field "REG_FIELD extract macro"
	\`define REG_FIELD(reg, msb, lsb) reg[msb:lsb]

snippet macro_reg_bit "REG_BIT check macro"
	\`define REG_BIT(reg, bit) reg[bit]

# =============================================================================
# TIMING MACROS
# =============================================================================

snippet macro_wait_clks "WAIT_CLKS macro"
	\`define WAIT_CLKS(n) \\
	    repeat(n) @(posedge clk);

snippet macro_wait_ns "WAIT_NS macro"
	\`define WAIT_NS(ns) \\
	    #(ns * 1ns);

snippet macro_wait_until "WAIT_UNTIL macro"
	\`define WAIT_UNTIL(cond) \\
	    wait(cond);

snippet macro_wait_clk_edge "WAIT_CLK_EDGE macro"
	\`define WAIT_CLK_EDGE \\
	    @(posedge clk);

# =============================================================================
# ARRAY/MEMORY MACROS
# =============================================================================

snippet macro_array_sum "ARRAY_SUM macro"
	\`define ARRAY_SUM(arr, size) \\
	    function int; \\
	        int sum = 0; \\
	        for (int i = 0; i < size; i++) \\
	            sum += arr[i]; \\
	        return sum; \\
	    endfunction

snippet macro_array_fill "ARRAY_FILL macro"
	\`define ARRAY_FILL(arr, size, val) \\
	    for (int i = 0; i < size; i++) \\
	        arr[i] = val;

snippet macro_array_copy "ARRAY_COPY macro"
	\`define ARRAY_COPY(dst, src, size) \\
	    for (int i = 0; i < size; i++) \\
	        dst[i] = src[i];

# =============================================================================
# CONDITIONAL COMPILATION MACROS
# =============================================================================

snippet macro_synthesis "SYNTHESIS conditional"
	\`ifdef SYNTHESIS
	    ${1:// Synthesis code}
	\`else
	    ${2:// Simulation code}
	\`endif

snippet macro_formal "FORMAL verification conditional"
	\`ifdef FORMAL
	    ${1:// Formal verification code}
	\`endif

snippet macro_coverage "COVERAGE conditional"
	\`ifdef COVERAGE
	    ${1:// Coverage code}
	\`endif

snippet macro_simulation "SIMULATION conditional"
	\`ifndef SYNTHESIS
	    ${1:// Simulation-only code}
	\`endif

# =============================================================================
# PARAMETERIZED MACROS (Advanced)
# =============================================================================

snippet macro_gen_comparator "Generate comparator macro"
	\`define GEN_COMPARATOR(name, width) \\
	module name ( \\
	    input  logic [width-1:0] a, \\
	    input  logic [width-1:0] b, \\
	    output logic             eq, \\
	    output logic             gt, \\
	    output logic             lt  \\
	); \\
	    assign eq = (a == b); \\
	    assign gt = (a > b); \\
	    assign lt = (a < b); \\
	endmodule

snippet macro_gen_register "Generate register macro"
	\`define GEN_REGISTER(name, width, reset_val) \\
	always_ff @(posedge clk or negedge rst_n) begin \\
	    if (!rst_n) \\
	        name <= reset_val; \\
	    else if (name``_en) \\
	        name <= name``_next; \\
	end

snippet macro_gen_fifo "Generate FIFO macro"
	\`define GEN_FIFO(name, width, depth) \\
	logic [width-1:0] name``_mem [depth]; \\
	logic [\$clog2(depth)-1:0] name``_wr_ptr, name``_rd_ptr; \\
	logic name``_full, name``_empty;

# =============================================================================
# PROTOCOL-SPECIFIC MACROS
# =============================================================================

snippet macro_axi_handshake "AXI handshake macro"
	\`define AXI_HANDSHAKE(valid, ready) \\
	    (valid && ready)

snippet macro_axi_wait "AXI wait for handshake macro"
	\`define AXI_WAIT_HANDSHAKE(valid, ready) \\
	    do begin \\
	        @(posedge clk); \\
	    end while (!(valid && ready));

snippet macro_apb_write "APB write macro"
	\`define APB_WRITE(addr, data) \\
	    @(posedge clk); \\
	    paddr = addr; \\
	    pwdata = data; \\
	    pwrite = 1'b1; \\
	    psel = 1'b1; \\
	    @(posedge clk); \\
	    penable = 1'b1; \\
	    @(posedge clk); \\
	    psel = 1'b0; \\
	    penable = 1'b0;

snippet macro_apb_read "APB read macro"
	\`define APB_READ(addr, data) \\
	    @(posedge clk); \\
	    paddr = addr; \\
	    pwrite = 1'b0; \\
	    psel = 1'b1; \\
	    @(posedge clk); \\
	    penable = 1'b1; \\
	    @(posedge clk); \\
	    data = prdata; \\
	    psel = 1'b0; \\
	    penable = 1'b0;

# =============================================================================
# STRING MANIPULATION MACROS
# =============================================================================

snippet macro_str_concat "String concatenation macro"
	\`define STR_CONCAT(a, b) {a, b}

snippet macro_str_format "String format macro"
	\`define STR_FORMAT(fmt, args) \\
	    \$sformatf(fmt, args)

snippet macro_to_hex "To hex string macro"
	\`define TO_HEX(val, width) \\
	    \$sformatf("0x%0h", val)

snippet macro_to_bin "To binary string macro"
	\`define TO_BIN(val, width) \\
	    \$sformatf("%0b", val)

# =============================================================================
# FILE I/O MACROS
# =============================================================================

snippet macro_file_open "File open macro"
	\`define FILE_OPEN(handle, filename, mode) \\
	    handle = \$fopen(filename, mode); \\
	    if (!handle) \\
	        \$fatal(1, "Failed to open file: filename");

snippet macro_file_write "File write macro"
	\`define FILE_WRITE(handle, fmt, args) \\
	    \$fdisplay(handle, fmt, args);

snippet macro_file_close "File close macro"
	\`define FILE_CLOSE(handle) \\
	    \$fclose(handle);

# =============================================================================
# RANDOM MACROS
# =============================================================================

snippet macro_rand_range "Random range macro"
	\`define RAND_RANGE(min, max) \\
	    (\$urandom_range(max, min))

snippet macro_rand_bool "Random boolean macro"
	\`define RAND_BOOL \\
	    (\$urandom() & 1)

snippet macro_rand_choice "Random choice macro"
	\`define RAND_CHOICE(arr, size) \\
	    arr[\$urandom_range(size-1, 0)]

# =============================================================================
# PERFORMANCE MEASUREMENT MACROS
# =============================================================================

snippet macro_perf_start "Performance measurement start"
	\`define PERF_START(name) \\
	    realtime name``_start_time = \$realtime;

snippet macro_perf_end "Performance measurement end"
	\`define PERF_END(name) \\
	    \$display("[PERF] name: %.2f ns", \$realtime - name``_start_time);

snippet macro_cycle_count "Cycle counter macro"
	\`define CYCLE_COUNT_START(name) \\
	    int name``_cycle_count = 0;

snippet macro_cycle_count_inc "Cycle counter increment"
	\`define CYCLE_COUNT_INC(name) \\
	    name``_cycle_count++;

snippet macro_cycle_count_report "Cycle counter report"
	\`define CYCLE_COUNT_REPORT(name) \\
	    \$display("[CYCLES] name: %0d cycles", name``_cycle_count);

# =============================================================================
# ADDITIONAL SYSTEMVERILOG CONSTRUCTS (IEEE 1800-2012)
# =============================================================================

snippet checker "Checker module"
	checker ${1:checker_name} (
	    ${2:input logic clk},
	    ${3:input logic rst_n}
	);
	    ${4:// Assertions}
	    ${0}
	endchecker: $1

snippet let "Let declaration"
	let ${1:name} = ${2:expression};

snippet expect "Expect statement"
	expect (${1:property_name}) else ${2:action};

snippet restrict "Restrict property"
	restrict property (${1:property_name});

snippet alias "Alias statement"
	alias ${1:new_name} = ${2:existing_name};

snippet nettype "User-defined nettype"
	nettype ${1:data_type} ${2:nettype_name} with ${3:resolution_function};

# =============================================================================
# INTERFACE AND MODPORT ADVANCED
# =============================================================================

snippet interface_class "Interface class"
	interface class ${1:interface_name};
	    pure virtual function ${2:void} ${3:method}(${4});
	endclass: $1

snippet implements "Implements interface class"
	implements ${1:interface_class_name}

snippet modport_clocking "Modport with clocking"
	modport ${1:name} (
	    clocking ${2:cb},
	    ${3:input reset}
	);

snippet interface_param "Parameterized interface"
	interface ${1:`expand('%:t:r')`} #(
	    parameter int ${2:WIDTH} = ${3:8}
	) (
	    input logic clk,
	    input logic rst_n
	);
	    ${4}
	endinterface: $1

# =============================================================================
# ADVANCED CLASS FEATURES
# =============================================================================

snippet extern_class "Extern class method"
	extern class ${1:class_name};

snippet constraint_mode "Constraint mode control"
	${1:constraint_name}.constraint_mode(${2:0});

snippet rand_mode "Randomization mode control"
	${1:variable}.rand_mode(${2:0});

snippet this "This keyword"
	this.${1:member}

snippet super "Super keyword"
	super.${1:method}(${2});

snippet new_array "Dynamic array new"
	${1:array} = new[${2:size}];

snippet new_copy "Copy constructor"
	${1:object} = new ${2:original};

# =============================================================================
# PACKAGE IMPORT AND EXPORT
# =============================================================================

snippet import_pkg "Import package"
	import ${1:package_name}::${2:*};

snippet export_pkg "Export from package"
	export ${1:package_name}::${2:*};

snippet import_item "Import specific item"
	import ${1:package_name}::${2:item_name};

# =============================================================================
# VIRTUAL INTERFACES
# =============================================================================

snippet virtual_interface "Virtual interface declaration"
	virtual ${1:interface_name} ${2:vif};

snippet virtual_interface_param "Parameterized virtual interface"
	virtual ${1:interface_name}#(${2:params}) ${3:vif};

# =============================================================================
# DPI (Direct Programming Interface)
# =============================================================================

snippet dpi_import "DPI-C import"
	import "DPI-C" function ${1:return_type} ${2:function_name}(${3:args});

snippet dpi_export "DPI-C export"
	export "DPI-C" function ${1:function_name};

snippet dpi_context "DPI-C context import"
	import "DPI-C" context function ${1:return_type} ${2:function_name}(${3:args});

snippet dpi_pure "DPI-C pure function"
	import "DPI-C" pure function ${1:return_type} ${2:function_name}(${3:args});

# =============================================================================
# PROGRAM BLOCKS (Advanced)
# =============================================================================

snippet program_clocking "Program with clocking"
	program ${1:`expand('%:t:r')`} (
	    ${2:interface_name}.${3:modport} ${4:port}
	);
	    clocking ${5:cb} @(posedge ${4}.clk);
	        ${6}
	    endclocking
	    
	    initial begin
	        ${0}
	    end
	endprogram: $1

# =============================================================================
# CONFIG AND BIND
# =============================================================================

snippet config "Configuration"
	config ${1:config_name};
	    design ${2:top_module};
	    ${3}
	endconfig: $1

snippet cell_config "Cell configuration"
	cell ${1:instance_path} use ${2:library}.${3:cell};

snippet instance_config "Instance configuration"
	instance ${1:instance_path} use ${2:configuration};

# =============================================================================
# SPECIFY BLOCKS (Timing)
# =============================================================================

snippet specify "Specify block"
	specify
	    specparam ${1:tPD} = ${2:10};
	    (${3:input} => ${4:output}) = $1;
	endspecify

snippet setuphold "Setup/Hold timing check"
	\$setuphold(posedge ${1:clk}, ${2:data}, ${3:setup_time}, ${4:hold_time});

snippet width_check "Width timing check"
	\$width(posedge ${1:signal}, ${2:min_width});

snippet period_check "Period timing check"
	\$period(posedge ${1:clk}, ${2:min_period});

# =============================================================================
# UNIQUE, PRIORITY, UNIQUE0
# =============================================================================

snippet unique_if "Unique if"
	unique if (${1:condition}) begin
	    ${2}
	end else if (${3:condition}) begin
	    ${4}
	end

snippet priority_if "Priority if"
	priority if (${1:condition}) begin
	    ${2}
	end else if (${3:condition}) begin
	    ${4}
	end

snippet unique0_case "Unique0 case"
	unique0 case (${1:expression})
	    ${2:value}: ${3}
	    default: ${4}
	endcase

# =============================================================================
# STREAMING OPERATORS
# =============================================================================

snippet stream_pack "Streaming pack operator"
	{<<{${1:data}}}

snippet stream_unpack "Streaming unpack operator"
	{>>{${1:data}}}

snippet stream_slice "Streaming with slice"
	{<<${1:8}{${2:data}}}

