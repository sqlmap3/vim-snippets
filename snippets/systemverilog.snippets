# =============================================================================

snippet array_size "Array size method"
	${1:array}.size()

snippet array_delete "Array delete method"
	${1:array}.delete(${2:index});

snippet array_exists "Array exists method"
	${1:array}.exists(${2:index})

snippet array_first "Array first method"
	${1:array}.first(${2:index})

snippet array_last "Array last method"
	${1:array}.last(${2:index})

snippet array_next "Array next method"
	${1:array}.next(${2:index})

snippet array_prev "Array prev method"
	${1:array}.prev(${2:index})

snippet array_find "Array find method"
	${1:array}.find(${2:item}) with (${3:item} == ${4:value})

snippet array_find_index "Array find_index method"
	${1:array}.find_index with (${2:item} == ${3:value})

snippet array_find_first "Array find_first method"
	${1:array}.find_first with (${2:item} > ${3:value})

snippet array_min "Array min method"
	${1:array}.min()

snippet array_max "Array max method"
	${1:array}.max()

snippet array_sum "Array sum method"
	${1:array}.sum()

snippet array_product "Array product method"
	${1:array}.product()

snippet array_and "Array and method"
	${1:array}.and()

snippet array_or "Array or method"
	${1:array}.or()

snippet array_xor "Array xor method"
	${1:array}.xor()

snippet array_unique "Array unique method"
	${1:array}.unique()

snippet array_sort "Array sort method"
	${1:array}.sort()

snippet array_rsort "Array reverse sort method"
	${1:array}.rsort()

snippet array_reverse "Array reverse method"
	${1:array}.reverse()

snippet array_shuffle "Array shuffle method"
	${1:array}.shuffle()

