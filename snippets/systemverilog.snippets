snippet string_len "String length method"
	${1:str}.len()

snippet string_getc "String getc method"
	${1:str}.getc(${2:index})

snippet string_putc "String putc method"
	${1:str}.putc(${2:index}, ${3:char})

snippet string_toupper "String to upper method"
	${1:str}.toupper()

snippet string_tolower "String to lower method"
	${1:str}.tolower()

snippet string_compare "String compare method"
	${1:str}.compare(${2:str2})

snippet string_icompare "String case-insensitive compare"
	${1:str}.icompare(${2:str2})

snippet string_substr "String substr method"
	${1:str}.substr(${2:start}, ${3:end})

snippet string_atoi "String to integer"
	${1:str}.atoi()

snippet string_atohex "String hex to integer"
	${1:str}.atohex()

snippet string_atooct "String octal to integer"
	${1:str}.atooct()

snippet string_atobin "String binary to integer"
	${1:str}.atobin()

snippet string_atoreal "String to real"
	${1:str}.atoreal()

snippet string_itoa "Integer to string"
	${1:str}.itoa(${2:value})

snippet string_hextoa "Hex to string"
	${1:str}.hextoa(${2:value})

snippet string_octtoa "Octal to string"
	${1:str}.octtoa(${2:value})

snippet string_bintoa "Binary to string"
	${1:str}.bintoa(${2:value})

snippet string_realtoa "Real to string"
	${1:str}.realtoa(${2:value})

# =============================================================================
# PROCESS CONTROL
# =============================================================================

snippet process_self "Process self"
	process::self()

snippet process_status "Process status"
	${1:proc}.status()

snippet process_kill "Process kill"
	${1:proc}.kill()

snippet process_await "Process await"
	${1:proc}.await()

snippet process_suspend "Process suspend"
	${1:proc}.suspend()

snippet process_resume "Process resume"
	${1:proc}.resume()

# =============================================================================
# REFINEMENT (IEEE 1800-2012)
# =============================================================================

snippet global_clocking "Global clocking"
	global clocking ${1:cb} @(posedge ${2:clk});
	    ${3}
	endclocking

snippet default_clocking "Default clocking"
	default clocking ${1:cb};

snippet default_disable "Default disable"
	default disable iff ${1:reset};

# =============================================================================
# COVERAGE OPTIONS
# =============================================================================

snippet covergroup_option "Covergroup options"
	option.name = "${1:name}";
	option.weight = ${2:1};
	option.goal = ${3:100};
	option.comment = "${4:comment}";
	option.at_least = ${5:1};
	option.auto_bin_max = ${6:64};
	option.per_instance = ${7:0};
	option.get_inst_coverage = ${8:0};

snippet coverpoint_option "Coverpoint options"
	option.weight = ${1:1};
	option.goal = ${2:100};
	option.comment = "${3:comment}";
	option.at_least = ${4:1};
	option.auto_bin_max = ${5:64};

# =============================================================================
# WILDCARD BINS
# =============================================================================

snippet bins_wildcard "Wildcard bins"
	wildcard bins ${1:name} = {${2:4'b10??}};

snippet bins_transition "Transition bins"
	bins ${1:name} = (${2:val1} => ${3:val2} => ${4:val3});

snippet bins_sequence "Sequence bins"
	bins ${1:name} = (${2:val1}[*${3:2}] => ${4:val2});

# =============================================================================
# RANDSEQUENCE
# =============================================================================

snippet randsequence "Random sequence"
	randsequence(${1:production})
	    ${1}: ${2:item1} ${3:| item2};
	    $2: ${4:/* actions */};
	    $3: ${5:/* actions */};
	endsequence

# =============================================================================
# SOFT CONSTRAINTS
# =============================================================================

snippet soft_constraint "Soft constraint"
	constraint ${1:name}_c {
	    soft ${2:variable} == ${3:value};
	}

# =============================================================================
# DIST CONSTRAINTS (Advanced)
# =============================================================================

snippet dist_weight "Distribution with weight"
	${1:variable} dist {
	    ${2:value1} := ${3:weight1},
	    ${4:value2} := ${5:weight2},
	    [${6:min}:${7:max}] := ${8:weight3}
	};

snippet dist_equal "Distribution with equal probability"
	${1:variable} dist {
	    ${2:value1}, ${3:value2}, ${4:value3}
	};

# =============================================================================
# IMPLICATION CONSTRAINTS
# =============================================================================

snippet constraint_implication "Constraint implication"
	constraint ${1:name}_c {
	    ${2:condition} -> ${3:constraint};
	}

snippet constraint_if "Constraint if-else"
	constraint ${1:name}_c {
	    if (${2:condition})
	        ${3:constraint1}
	    else
	        ${4:constraint2}
	}

# =============================================================================
# FOREACH IN CONSTRAINTS
# =============================================================================

snippet constraint_foreach "Foreach in constraint"
	constraint ${1:name}_c {
	    foreach (${2:array}[${3:i}])
	        ${2}[$3] ${4:inside {[0:10]}};
	}

# =============================================================================
# UNIQUE IN CONSTRAINTS
# =============================================================================

snippet constraint_unique "Unique constraint"
	constraint ${1:name}_c {
	    unique {${2:var1}, ${3:var2}, ${4:var3}};
	}

# =============================================================================
# INLINE RANDOMIZATION
# =============================================================================

snippet randomize_inline "Inline randomization"
	std::randomize(${1:variable}) with {
	    $1 ${2:inside {[0:100]}};
	};

# =============================================================================
# CROSS COVERAGE (Advanced)
# =============================================================================

snippet cross_binsof "Cross with binsof"
	${1:name}_cross: cross ${2:cp1}, ${3:cp2} {
	    ignore_bins ${4:ignore} = binsof(${2}) intersect {${5:values}};
	}

snippet cross_iff "Cross with iff"
	${1:name}_cross: cross ${2:cp1}, ${3:cp2} iff (${4:condition});

# =============================================================================
# SYSTEM FUNCTIONS (Additional)
# =============================================================================

snippet countones "Count ones"
	\$countones(${1:expression})

snippet countbits "Count bits"
	\$countbits(${1:expression}, ${2:'1})

snippet onehot "One-hot check"
	\$onehot(${1:expression})

snippet onehot0 "One-hot or zero check"
	\$onehot0(${1:expression})

snippet isunknown "Is unknown check"
	\$isunknown(${1:expression})

snippet bits "Bits function"
	\$bits(${1:expression})

snippet typename "Type name"
	\$typename(${1:expression})

snippet high "High index"
	\$high(${1:array})

snippet low "Low index"
	\$low(${1:array})

snippet left "Left index"
	\$left(${1:array})

snippet right "Right index"
	\$right(${1:array})

snippet increment "Increment"
	\$increment(${1:array})

snippet size "Size function"
	\$size(${1:array}, ${2:dimension})

snippet dimensions "Dimensions"
	\$dimensions(${1:array})

snippet unpacked_dimensions "Unpacked dimensions"
	\$unpacked_dimensions(${1:array})

# =============================================================================
# SEVERITY SYSTEM TASKS
# =============================================================================

snippet fatal "Fatal system task"
	\$fatal(${1:finish_number}, "${2:message}", ${3:args});

snippet error "Error system task"
	\$error("${1:message}", ${2:args});

snippet warning "Warning system task"
	\$warning("${1:message}", ${2:args});

snippet info "Info system task"
	\$info("${1:message}", ${2:args});


# =============================================================================
# UVM HDL ACCESS (uvm_hdl_read/force/deposit)
# =============================================================================

snippet uvm_hdl_read "UVM HDL Read"
	uvm_hdl_read("${1:hdl_path}", ${2:value});

snippet uvm_hdl_force "UVM HDL Force"
	uvm_hdl_force("${1:hdl_path}", ${2:value});

snippet uvm_hdl_release "UVM HDL Release"
	uvm_hdl_release("${1:hdl_path}");

snippet uvm_hdl_deposit "UVM HDL Deposit"
	uvm_hdl_deposit("${1:hdl_path}", ${2:value});

snippet uvm_hdl_check_path "UVM HDL Check Path"
	uvm_hdl_check_path("${1:hdl_path}");

snippet uvm_hdl_read_string "UVM HDL Read String"
	uvm_hdl_read_string("${1:hdl_path}", ${2:str_value});

snippet uvm_hdl_force_string "UVM HDL Force String"
	uvm_hdl_force_string("${1:hdl_path}", "${2:str_value}");

snippet uvm_hdl_deposit_string "UVM HDL Deposit String"
	uvm_hdl_deposit_string("${1:hdl_path}", "${2:str_value}");

# =============================================================================
# SYSTEMVERILOG SIMULATION CONTROL TASKS
# =============================================================================

snippet finish "Finish simulation"
	\$finish;

snippet stop "Stop simulation"
	\$stop;

snippet restart "Restart simulation"
	\$restart;

snippet reset "Reset simulation"
	\$reset;

snippet save "Save simulation state"
	\$save;

snippet restore "Restore simulation state"
	\$restore;

snippet checkpoint "Simulation checkpoint"
	\$checkpoint;
