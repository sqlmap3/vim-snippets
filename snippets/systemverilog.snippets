# =============================================================================
# FILE TEMPLATES AND HEADERS
# =============================================================================

snippet sv_header "SystemVerilog file header"
	//==============================================================================
	// File        : ${1:`expand('%:t')`}
	// Project     : ${2:Project Name}
	// Module      : ${3:`expand('%:t:r')`}
	// Author      : ${4:$USER}
	// Created     : ${5:`strftime("%Y-%m-%d")`}
	// Modified    : ${6:`strftime("%Y-%m-%d")`}
	//==============================================================================
	// Description:
	//   ${7:Brief description}
	//==============================================================================
	
	${0}

snippet header_guard "Header guard"
	\`ifndef ${1:`toupper(substitute(expand('%:t:r'), '[^A-Z0-9]', '_', 'g'))`}_SVH
	\`define $1_SVH
	
	${0}
	
	\`endif // $1_SVH

snippet tb "Testbench template"
	\`timescale 1ns/1ps
	
	module ${1:`expand('%:t:r')`};
	
	    localparam int PERIOD = ${2:10};
	    
	    logic ${3:clk};
	    logic ${4:rst_n};
	    ${5}
	
	    // Clock generation
	    initial begin
	        $3 = 0;
	        forever #(PERIOD/2) $3 = ~$3;
	    end
	
	    // Reset generation
	    initial begin
	        $4 = 0;
	        repeat(2) @(posedge $3);
	        $4 = 1;
	    end
	
	    // DUT instantiation
	    ${6:dut} u_dut (
	        .clk($3),
	        .rst_n($4)${7}
	    );
	
	    // Test stimulus
	    initial begin
	        @(posedge $4);
	        ${0}
	        #1000;
	        \$finish;
	    end
	
	    // Waveform dump
	    initial begin
	        \$dumpfile("${8:`expand('%:t:r')`}.vcd");
	        \$dumpvars(0, $1);
	    end
	
	endmodule: $1

